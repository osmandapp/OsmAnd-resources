    <tag k='description' v='Fjällastugan är en friluftsanläggning I Gullmarsskogens naturreservat. Stugan står öppen för de som använder de olika ströv- och motionsspåren i området.' />
    <tag k='description:en' v='Fjälla Cottage is an open for those hiking on the many trail in the reserve. The &quot;Fjällastugan&quot; offers a sauna and two dressing rooms with showers, and it is available all year round for those who want to warm up, eat packed food or change clothes.' />
    <tag k='fireplace' v='yes' />
    <tag k='image' v='File:Fjällastugan front view.jpg' />
    <tag k='name' v='Fjällastugan' />
    <tag k='name:signed' v='Fjälla Stugan' />
    <tag k='operator' v='Filuftsfrämjandet' />
