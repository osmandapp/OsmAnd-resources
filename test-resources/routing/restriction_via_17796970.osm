  <node id='13302461203' timestamp='2025-11-22T15:37:45Z' uid='3476229' user='maro21' visible='true' version='2' changeset='174993672' lat='51.0949714' lon='17.0213937'>
    <tag k='board_type' v='history' />
    <tag k='information' v='board' />
    <tag k='inscription' v='W tym miejscu 6 maja 1945 roku w godzinach porannych spotkali się parlamentariusze wojsk niemieckich i sowieckich w celu ustalenia warunków kapitulacji Wrocławia zamienionego przez hitlerowców w Festung Breslau.' />
    <tag k='inscription:2' v='Podpisany wieczorem w willi „Colonia” akt kapitulacji zakończył działania militarne w Europie.' />
    <tag k='inscription:en' v='On this site, in the morning of May 6, 1945, envoys of the German and Soviet armies met to agree on the terms of the capitulation of Wrocław, which had been turned by the Nazis into Festung Breslau.' />
    <tag k='inscription:en:2' v='The act of surrender, signed that evening in the &quot;Colonia&quot; villa, marked the end of military operations in Europe.' />
    <tag k='name' v='1945 – Kapitulacja Festung Breslau' />
    <tag k='tourism' v='information' />
  </node>
