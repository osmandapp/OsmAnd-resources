<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <index>
        <!-- RF1: the road number belongs to the same name as the full phrase. -->
        <rule object="street" from="(?iu)\bStrada\s+Statale\b" to="SS"/>
        <rule object="street" from="(?iu)\bStrada\s+Statale\s+(\d+)\b" to="SS$1"/>
        <rule object="street" from="(?iu)\bStrada\s+Provinciale\b" to="SP"/>
        <rule object="street" from="(?iu)\bStrada\s+Provinciale\s+(\d+)\b" to="SP$1"/>
        <rule object="street" from="(?iu)\bStrada\s+Regionale\b" to="SR"/>
        <rule object="street" from="(?iu)\bStrada\s+Regionale\s+(\d+)\b" to="SR$1"/>
    </index>
    <!-- EL1 uses UnglueRule. -->
    <query>
        <!-- SA1, query.db: "P.za S. Giovanni Paolo II", "Cappella di S. Andrea"; OSM names spell the saint in full.
             Candidate for measuring on full OBF: "s" is one letter, AbbreviationMetrics decides whether it stays. -->
        <rule from="s">
            <to object="street,locality,poi">San</to>
            <to object="street,locality,poi">Santo</to>
            <to object="street,locality,poi">Santa</to>
        </rule>
        <!-- house number suffixes: "12 bis", "12/ter" -->
        <rule from="bis" object="building"/>
        <rule from="ter" object="building"/>
        <rule from="il" to=""/>
        <rule from="la" to=""/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QASL\E(?![\p{L}\p{M}\p{N}])\.?" to="Azienda Sanitaria Locale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAzienda Sanitaria Locale\E(?![\p{L}\p{M}\p{N}])" to="ASL"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAvv\E(?![\p{L}\p{M}\p{N}])\.?" to="Avvocato"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAvvocato\E(?![\p{L}\p{M}\p{N}])" to="Avv"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QBCC\E(?![\p{L}\p{M}\p{N}])\.?" to="Banca di Credito Cooperativo"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QBanca di Credito Cooperativo\E(?![\p{L}\p{M}\p{N}])" to="BCC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCAF\E(?![\p{L}\p{M}\p{N}])\.?" to="Centro di Assistenza Fiscale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCentro di Assistenza Fiscale\E(?![\p{L}\p{M}\p{N}])" to="CAF"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCFP\E(?![\p{L}\p{M}\p{N}])\.?" to="Centro di Formazione Professionale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCentro di Formazione Professionale\E(?![\p{L}\p{M}\p{N}])" to="CFP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIIS\E(?![\p{L}\p{M}\p{N}])\.?" to="Istituto di Istruzione Superiore"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIstituto di Istruzione Superiore\E(?![\p{L}\p{M}\p{N}])" to="IIS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QINPS\E(?![\p{L}\p{M}\p{N}])\.?" to="Istituto Nazionale della Previdenza Sociale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIstituto Nazionale della Previdenza Sociale\E(?![\p{L}\p{M}\p{N}])" to="INPS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIPSIA\E(?![\p{L}\p{M}\p{N}])\.?" to="Istituto Professionale di Stato per l&#x27;Industria e l&#x27;Artigianato"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIstituto Professionale di Stato per l&#x27;Industria e l&#x27;Artigianato\E(?![\p{L}\p{M}\p{N}])" to="IPSIA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QISIS\E(?![\p{L}\p{M}\p{N}])\.?" to="Istituto Statale di Istruzione Superiore"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIstituto Statale di Istruzione Superiore\E(?![\p{L}\p{M}\p{N}])" to="ISIS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QITIS\E(?![\p{L}\p{M}\p{N}])\.?" to="Istituto Tecnico Industriale Statale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIstituto Tecnico Industriale Statale\E(?![\p{L}\p{M}\p{N}])" to="ITIS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRiv\E(?![\p{L}\p{M}\p{N}])\.?" to="Rivendita"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRivendita\E(?![\p{L}\p{M}\p{N}])" to="Riv"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRSA\E(?![\p{L}\p{M}\p{N}])\.?" to="Residenza Sanitaria Assistenziale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QResidenza Sanitaria Assistenziale\E(?![\p{L}\p{M}\p{N}])" to="RSA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSIC\E(?![\p{L}\p{M}\p{N}])\.?" to="Sito di Importanza Comunitaria"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSito di Importanza Comunitaria\E(?![\p{L}\p{M}\p{N}])" to="SIC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QUOC\E(?![\p{L}\p{M}\p{N}])\.?" to="Unità Operativa Complessa"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QUnità Operativa Complessa\E(?![\p{L}\p{M}\p{N}])" to="UOC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QUSL\E(?![\p{L}\p{M}\p{N}])\.?" to="Unità Sanitaria Locale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QUnità Sanitaria Locale\E(?![\p{L}\p{M}\p{N}])" to="USL"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVVF\E(?![\p{L}\p{M}\p{N}])\.?" to="Vigili del Fuoco"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVigili del Fuoco\E(?![\p{L}\p{M}\p{N}])" to="VVF"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZPS\E(?![\p{L}\p{M}\p{N}])\.?" to="Zona di Protezione Speciale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZona di Protezione Speciale\E(?![\p{L}\p{M}\p{N}])" to="ZPS"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Basko" tags="shop=supermarket"/>
        <brand value="Boggi" tags="shop=clothes"/>
        <brand value="Camomilla" tags="shop=clothes"/>
        <brand value="Fideuram" tags="amenity=bank"/>
        <brand value="Gabetti" tags="office=estate_agent"/>
        <brand value="IBL Banca" tags="amenity=bank"/>
        <brand value="Matchpoint" tags="shop=bookmaker"/>
        <brand value="Più me" tags="shop=chemist"/>
        <brand value="Scavolini" tags="shop=kitchen | shop=furniture"/>
        <brand value="Sisal" tags="shop=bookmaker"/>
        <brand value="SMA" tags="shop=supermarket"/>
        <brand value="Tecnorete" tags="office=estate_agent"/>
        <brand value="Visionottica" tags="shop=optician"/>
    </poi>
</rules>
