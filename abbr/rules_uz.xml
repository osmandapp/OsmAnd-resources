<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="DMTT" full="Davlat maktabgacha ta'lim tashkiloti"/>
        <abbr short="IDUM" full="Ixtisoslashtirilgan davlat umumiy o'rta ta'lim maktabi"/>
        <abbr short="IIB" full="Ichki ishlar bo'limi"/>
        <abbr short="MFY" full="Mahalla fuqarolar yig'ini"/>
        <abbr short="MTM" full="Maktabgacha ta'lim muassasasi"/>
        <abbr short="MTT" full="Maktabgacha ta'lim tashkiloti"/>
        <brand value="Gross Insurance" tags="office=insurance"/>
        <brand value="Ipoteka Bank" tags="amenity=bank"/>
        <brand value="O'zsanoatqurilishbank" tags="amenity=bank"/>
        <brand value="Барака" tags="shop=convenience"/>
    </poi>
</rules>
