<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QDPWH\E(?![\p{L}\p{M}\p{N}])\.?" to="Department of Public Works and Highways"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QDepartment of Public Works and Highways\E(?![\p{L}\p{M}\p{N}])" to="DPWH"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLTO\E(?![\p{L}\p{M}\p{N}])\.?" to="Land Transportation Office"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLand Transportation Office\E(?![\p{L}\p{M}\p{N}])" to="LTO"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPCSO\E(?![\p{L}\p{M}\p{N}])\.?" to="Philippine Charity Sweepstakes Office"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPhilippine Charity Sweepstakes Office\E(?![\p{L}\p{M}\p{N}])" to="PCSO"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPNP\E(?![\p{L}\p{M}\p{N}])\.?" to="Philippine National Police"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPhilippine National Police\E(?![\p{L}\p{M}\p{N}])" to="PNP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRTW\E(?![\p{L}\p{M}\p{N}])\.?" to="Ready to Wear"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QReady to Wear\E(?![\p{L}\p{M}\p{N}])" to="RTW"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSPED\E(?![\p{L}\p{M}\p{N}])\.?" to="Special Education"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSpecial Education\E(?![\p{L}\p{M}\p{N}])" to="SPED"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTODA\E(?![\p{L}\p{M}\p{N}])\.?" to="Tricycle Operators and Drivers Association"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTricycle Operators and Drivers Association\E(?![\p{L}\p{M}\p{N}])" to="TODA"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="AMA" tags="amenity=college"/>
        <brand value="Monterey" tags="shop=butcher"/>
        <brand value="Motolite" tags="shop=car_parts"/>
        <brand value="Motorstar" tags="shop=motorcycle"/>
        <brand value="Pandayan" tags="shop=books"/>
        <brand value="Philtrust" tags="amenity=bank"/>
        <brand value="Puremart" tags="shop=convenience"/>
        <brand value="Savory" tags="amenity=restaurant"/>
        <brand value="SM" tags="shop=supermarket | shop=mall"/>
        <brand value="Wilcon" tags="shop=doityourself"/>
    </poi>
</rules>
