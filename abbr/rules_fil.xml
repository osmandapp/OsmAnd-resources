<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="DPWH" full="Department of Public Works and Highways"/>
        <abbr short="LTO" full="Land Transportation Office"/>
        <abbr short="PCSO" full="Philippine Charity Sweepstakes Office"/>
        <abbr short="PNP" full="Philippine National Police"/>
        <abbr short="RTW" full="Ready to Wear"/>
        <abbr short="SPED" full="Special Education"/>
        <abbr short="TODA" full="Tricycle Operators and Drivers Association"/>
        <brand value="AMA" tags="amenity=college"/>
        <brand value="Monterey" tags="shop=butcher"/>
        <brand value="Motolite" tags="shop=car_parts"/>
        <brand value="Motorstar" tags="shop=motorcycle"/>
        <brand value="Pandayan" tags="shop=books"/>
        <brand value="Philtrust" tags="amenity=bank"/>
        <brand value="Puremart" tags="shop=convenience"/>
        <brand value="Savory" tags="amenity=restaurant"/>
        <brand value="SM" tags="shop=supermarket | shop=mall"/>
        <brand value="Wilcon" tags="shop=doityourself"/>
    </poi>
</rules>
