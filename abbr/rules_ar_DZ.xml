<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="ANEM" tags="office=employment_agency" name="\bANEM\b"/>
        <service word="APC" tags="amenity=townhall" name="\bAPC\b|\bAssemblée\ Populaire\ Communale\b"/>
        <service word="CNAS" tags="office=insurance | office=government + government=social_security"/>
        <service word="CNAS" tags="office=insurance" name="\bCNAS\b|\bCaisse\ Nationale\ des\ Assurances\ Sociales\b"/>
        <service word="EPSP" tags="amenity=clinic" name="\bEPSP\b|\bÉtablissement\ Public\ de\ Santé\ de\ Proximité\b"/>
        <service word="OPGI" tags="office=government" name="\bOPGI\b"/>
    </poi>
</rules>
