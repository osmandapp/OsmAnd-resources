<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSZC\E(?![\p{L}\p{M}\p{N}])\.?" to="Szakképzési Centrum"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSzakképzési Centrum\E(?![\p{L}\p{M}\p{N}])" to="SZC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QÓVI\E(?![\p{L}\p{M}\p{N}])\.?" to="Óvoda"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QÓvoda\E(?![\p{L}\p{M}\p{N}])" to="ÓVI"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Bárdi" tags="shop=car_parts"/>
        <brand value="Takarék" tags="amenity=bank"/>
        <brand value="Unix" tags="shop=car_parts"/>
    </poi>
</rules>
