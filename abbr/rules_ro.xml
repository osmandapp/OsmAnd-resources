<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCMI\E(?![\p{L}\p{M}\p{N}])\.?" to="Cabinet Medical Individual"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCabinet Medical Individual\E(?![\p{L}\p{M}\p{N}])" to="CMI"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QITP\E(?![\p{L}\p{M}\p{N}])\.?" to="Inspecția Tehnică Periodică"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QInspecția Tehnică Periodică\E(?![\p{L}\p{M}\p{N}])" to="ITP"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Cargus" tags="amenity=post_office | amenity=parcel_locker"/>
        <brand value="FAN Courier" tags="amenity=post_office"/>
        <brand value="Maicom" tags="shop=clothes"/>
        <brand value="Ropharma" tags="amenity=pharmacy"/>
        <brand value="Агропромбанк" tags="amenity=bank | amenity=atm"/>
    </poi>
</rules>
