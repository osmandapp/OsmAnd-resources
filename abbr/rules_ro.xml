<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="CMI" full="Cabinet Medical Individual"/>
        <abbr short="ITP" full="Inspecția Tehnică Periodică"/>
        <brand value="Cargus" tags="amenity=post_office | amenity=parcel_locker"/>
        <brand value="FAN Courier" tags="amenity=post_office"/>
        <brand value="Maicom" tags="shop=clothes"/>
        <brand value="Ropharma" tags="amenity=pharmacy"/>
        <brand value="Агропромбанк" tags="amenity=bank | amenity=atm"/>
    </poi>
</rules>
