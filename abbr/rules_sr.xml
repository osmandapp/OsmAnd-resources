<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <rule from="и" to=""/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QОШ\E(?![\p{L}\p{M}\p{N}])\.?" to="Основна школа"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QОсновна школа\E(?![\p{L}\p{M}\p{N}])" to="ОШ"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Maelia" tags="amenity=pharmacy"/>
        <brand value="Maxi GO" tags="shop=convenience"/>
    </poi>
</rules>
