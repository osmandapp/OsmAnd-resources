<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="BIR" tags="office=government" name="\bBIR\b"/>
        <service word="DENR" tags="office=government" name="\bDENR\b"/>
        <service word="DepEd" tags="office=government" name="\bDepEd\b"/>
        <service word="DPWH" tags="office=government" name="\bDPWH\b|\bDepartment\ of\ Public\ Works\ and\ Highways\b"/>
        <service word="LTO" tags="office=government" name="\bLTO\b|\bLand\ Transportation\ Office\b"/>
        <service word="PCSO" tags="shop=lottery" name="\bPCSO\b|\bPhilippine\ Charity\ Sweepstakes\ Office\b"/>
        <service word="PNP" tags="amenity=police" name="\bPNP\b|\bPhilippine\ National\ Police\b"/>
        <service word="SSS" tags="office=government" name="\bSSS\b"/>
    </poi>
</rules>
