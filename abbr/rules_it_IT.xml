<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="ACI" tags="office=government" name="\bACI\b"/>
        <service word="ACLI" tags="amenity=community_centre | amenity=bar | amenity=cafe" name="\bACLI\b"/>
        <service word="AGESCI" tags="club=scout" name="\bAGESCI\b"/>
        <service word="ARCI" tags="amenity=bar | amenity=community_centre | amenity=cafe" name="\bARCI\b"/>
        <service word="ASL" tags="amenity=clinic | amenity=doctors" name="\bASL\b"/>
        <service word="ASL" tags="amenity=hospital | amenity=clinic | amenity=doctors" name="\bASL\b|\bAzienda\ Sanitaria\ Locale\b"/>
        <service word="CAF" tags="office=tax_advisor" name="\bCAF\b|\bCentro\ di\ Assistenza\ Fiscale\b"/>
        <service word="CGIL" tags="office=union" name="\bCGIL\b"/>
        <service word="CISL" tags="office=union" name="\bCISL\b"/>
        <service word="INPS" tags="office=government" name="\bINPS\b|\bIstituto\ Nazionale\ della\ Previdenza\ Sociale\b"/>
        <service word="VVF" tags="amenity=fire_station" name="\bVVF\b|\bVigili\ del\ Fuoco\b"/>
    </poi>
</rules>
