<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="PTT" full="Posta ve Telgraf Teşkilatı"/>
        <abbr short="SGK" full="Sosyal Güvenlik Kurumu"/>
        <brand value="Albaraka" tags="amenity=bank"/>
        <brand value="Cineverse" tags="amenity=cinema"/>
        <brand value="İsbike" tags="amenity=bicycle_rental"/>
        <brand value="Jolly" tags="shop=travel_agency"/>
        <brand value="LC Waikiki" tags="shop=clothes"/>
        <brand value="Paribu" tags="amenity=cinema"/>
        <brand value="Sürat Kargo" tags="amenity=post_office"/>
    </poi>
</rules>
