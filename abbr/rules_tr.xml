<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPTT\E(?![\p{L}\p{M}\p{N}])\.?" to="Posta ve Telgraf Teşkilatı"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPosta ve Telgraf Teşkilatı\E(?![\p{L}\p{M}\p{N}])" to="PTT"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSGK\E(?![\p{L}\p{M}\p{N}])\.?" to="Sosyal Güvenlik Kurumu"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSosyal Güvenlik Kurumu\E(?![\p{L}\p{M}\p{N}])" to="SGK"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Albaraka" tags="amenity=bank"/>
        <brand value="Cineverse" tags="amenity=cinema"/>
        <brand value="İsbike" tags="amenity=bicycle_rental"/>
        <brand value="Jolly" tags="shop=travel_agency"/>
        <brand value="LC Waikiki" tags="shop=clothes"/>
        <brand value="Paribu" tags="amenity=cinema"/>
        <brand value="Sürat Kargo" tags="amenity=post_office"/>
    </poi>
</rules>
