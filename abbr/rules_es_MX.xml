<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="CFE" tags="office=energy_supplier"/>
        <service word="COBACAM" tags="amenity=school" name="\bCOBACAM\b|\bColegio\ de\ Bachilleres\ del\ Estado\ de\ Campeche\b"/>
        <service word="COBAEV" tags="amenity=school" name="\bCOBAEV\b|\bColegio\ de\ Bachilleres\ del\ Estado\ de\ Veracruz\b"/>
        <service word="CONAFE" tags="amenity=kindergarten | amenity=school" name="\bCONAFE\b|\b(Preescolar|Primaria|Secundaria|Telesecundaria|Cursos)(\ Ind[ií]gena)?\ Comunitari[oa]s?\b" operator="\bCONAFE\b|\bConsejo\ Nacional\ de\ Fomento\ Educativo\b"/>
        <service word="CONALEP" tags="amenity=school" name="\bCONALEP\b|\bColegio\ Nacional\ de\ Educación\ Profesional\ Técnica\b"/>
        <service word="Diconsa" tags="shop=convenience" name="\bDiconsa\b" operator="\bDiconsa\b"/>
        <service word="DIF" tags="amenity=social_facility" name="\bDIF\b" operator="\bDIF\b"/>
        <service word="IMSS" tags="amenity=hospital | amenity=clinic" name="\bIMSS\b|\bInstituto\ Mexicano\ del\ Seguro\ Social\b" operator="\bIMSS\b|\bInstituto\ Mexicano\ del\ Seguro\ Social\b"/>
        <service word="INE" tags="office=government" name="\bINE\b|\bInstituto\ Nacional\ Electoral\b"/>
        <service word="ISSSTE" tags="amenity=hospital | amenity=clinic" name="\bISSSTE\b" operator="\bISSSTE\b"/>
        <service word="ISSSTE" tags="amenity=hospital" name="\bISSSTE\b|\bInstituto\ de\ Seguridad\ y\ Servicios\ Sociales\ de\ los\ Trabajadores\ del\ Estado\b" operator="\bISSSTE\b|\bInstituto\ de\ Seguridad\ y\ Servicios\ Sociales\ de\ los\ Trabajadores\ del\ Estado\b"/>
    </poi>
</rules>
