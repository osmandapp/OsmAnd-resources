<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLKV\E(?![\p{L}\p{M}\p{N}])\.?" to="Laillistettu kiinteistönvälittäjä"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLaillistettu kiinteistönvälittäjä\E(?![\p{L}\p{M}\p{N}])" to="LKV"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVPK\E(?![\p{L}\p{M}\p{N}])\.?" to="Vapaaehtoinen palokunta"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVapaaehtoinen palokunta\E(?![\p{L}\p{M}\p{N}])" to="VPK"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="DNA" tags="shop=mobile_phone"/>
        <brand value="Esperi" tags="amenity=social_facility"/>
        <brand value="Pilke" tags="amenity=kindergarten"/>
        <brand value="Touhula" tags="amenity=kindergarten"/>
    </poi>
</rules>
