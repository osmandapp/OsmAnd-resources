<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="LKV" full="Laillistettu kiinteistönvälittäjä"/>
        <abbr short="VPK" full="Vapaaehtoinen palokunta"/>
        <brand value="DNA" tags="shop=mobile_phone"/>
        <brand value="Esperi" tags="amenity=social_facility"/>
        <brand value="Pilke" tags="amenity=kindergarten"/>
        <brand value="Touhula" tags="amenity=kindergarten"/>
    </poi>
</rules>
