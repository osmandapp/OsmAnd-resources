<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="BEHS" full="Basic Education High School"/>
        <abbr short="BEMS" full="Basic Education Middle School"/>
        <abbr short="BEPS" full="Basic Education Primary School"/>
        <abbr short="WLS" full="Wildlife Sanctuary"/>
        <abbr short="အထက" full="အခြေခံပညာအထက်တန်းကျောင်း"/>
        <abbr short="အမက" full="အခြေခံပညာမူလတန်းကျောင်း"/>
        <abbr short="အလက" full="အခြေခံပညာအလယ်တန်းကျောင်း"/>
    </poi>
</rules>
