<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="BPJS" tags="office=government" name="\bBPJS\b"/>
        <service word="BPN" tags="office=government" name="\bBPN\b"/>
        <service word="DPRD" tags="office=government" name="\bDPRD\b|\bDewan\ Perwakilan\ Rakyat\ Daerah\b"/>
        <service word="KPP" tags="office=government" name="\bKPP\b"/>
        <service word="KUA" tags="office=government" name="\bKUA\b|\bKantor\ Urusan\ Agama\b"/>
        <service word="LPD" tags="amenity=bank" name="\bLPD\b|\bLembaga\ Perkreditan\ Desa\b"/>
        <service word="PDAM" tags="office=water_utility | office=government" name="\bPDAM\b"/>
        <service word="PDAM" tags="office=water_utility" name="\bPDAM\b|\bPerusahaan\ Daerah\ Air\ Minum\b"/>
        <service word="PLN" tags="office=energy_supplier" name="\bPLN\b"/>
        <service word="PMI" tags="amenity=blood_bank | office=ngo" name="\bPMI\b"/>
    </poi>
</rules>
