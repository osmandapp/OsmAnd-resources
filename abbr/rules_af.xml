<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNG\E(?![\p{L}\p{M}\p{N}])\.?" to="Nederduitse Gereformeerde Kerk"/>  <!-- also: Dutch Reformed Church -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNederduitse Gereformeerde Kerk\E(?![\p{L}\p{M}\p{N}])" to="NG"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSAPS\E(?![\p{L}\p{M}\p{N}])\.?" to="South African Police Service"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSouth African Police Service\E(?![\p{L}\p{M}\p{N}])" to="SAPS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTVET\E(?![\p{L}\p{M}\p{N}])\.?" to="Technical and Vocational Education and Training"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTechnical and Vocational Education and Training\E(?![\p{L}\p{M}\p{N}])" to="TVET"/>
    </index>
</rules>
