<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="RFS" tags="amenity=fire_station" name="\bRFS\b|\bRural\ Fire\ Service\b" operator="\bRFS\b|\bRural\ Fire\ Service\b"/>
        <service word="TAFE" tags="amenity=college" name="\bTAFE\b|\bTechnical\ and\ Further\ Education\b" operator="\bTAFE\b|\bTechnical\ and\ Further\ Education\b"/>
    </poi>
</rules>
