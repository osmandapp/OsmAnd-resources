<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <rule from="и" to=""/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QООУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Општинско основно училиште"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QОпштинско основно училиште\E(?![\p{L}\p{M}\p{N}])" to="ООУ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПООУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Подрачно основно училиште"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПодрачно основно училиште\E(?![\p{L}\p{M}\p{N}])" to="ПООУ"/>
    </index>
</rules>
