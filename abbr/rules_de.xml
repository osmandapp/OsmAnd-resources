<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- Titles of names: "St. Johannis" is Sankt, never a street; "Dr.-Weber-Straße" is Doktor. -->
    <index>
        <!-- A3: joined street type without a final dot; leave standalone Straße/Platz untouched. -->
        <rule object="street" mode="All" from="(?iu)\b([\p{L}\p{M}]{2,})straße\b" to="$1str"/>
        <rule object="street" mode="All" from="(?iu)\b([\p{L}\p{M}]{2,})platz\b" to="$1pl"/>
    </index>
    <query>
        <rule from="st" to="Sankt"/>
        <rule from="dr" to="Doktor"/>
        <!-- query.db: a standalone "Str." after an adjective or a hyphen ("Kölner Str. 80", "Leopold-Kell-Str. 20");
             the joined "Hauptstr." is the index rule A3. -->
        <rule from="str" to="Straße" object="street"/>
        <rule from="der" to=""/>
        <rule from="den" to=""/>
        <rule from="die" to=""/>
        <rule from="das" to=""/>
        <rule from="und" to=""/>
        <!-- "Hannover Hbf" for the station "Hannover Hauptbahnhof"; the reverse form finds names with "Hbf" -->
        <rule from="hbf" to="Hauptbahnhof" object="poi"/>
        <skipPenalty>st sankt dr doktor</skipPenalty>
    </query>
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="AMS" full="Arbeitsmarktservice"/>
        <abbr short="ASB" full="Arbeiter-Samariter-Bund"/>
