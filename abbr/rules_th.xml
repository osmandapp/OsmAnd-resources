<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="NGV" full="Natural Gas Vehicle"/>
        <abbr short="ผญบ." full="ผู้ใหญ่บ้าน"/>
        <abbr short="สตจ." full="สภาคริสตจักร"/>
        <brand value="MK" tags="amenity=restaurant"/>
        <brand value="ไปรษณีย์ไทย" tags="amenity=post_office"/>
    </poi>
</rules>
