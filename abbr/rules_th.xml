<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNGV\E(?![\p{L}\p{M}\p{N}])\.?" to="Natural Gas Vehicle"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNatural Gas Vehicle\E(?![\p{L}\p{M}\p{N}])" to="NGV"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\Qผญบ.\E(?![\p{L}\p{M}\p{N}])\.?" to="ผู้ใหญ่บ้าน"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\Qผู้ใหญ่บ้าน\E(?![\p{L}\p{M}\p{N}])" to="ผญบ."/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\Qสตจ.\E(?![\p{L}\p{M}\p{N}])\.?" to="สภาคริสตจักร"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\Qสภาคริสตจักร\E(?![\p{L}\p{M}\p{N}])" to="สตจ."/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="MK" tags="amenity=restaurant"/>
        <brand value="ไปรษณีย์ไทย" tags="amenity=post_office"/>
    </poi>
</rules>
