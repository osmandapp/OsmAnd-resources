<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <index>
        <!-- Pairs that were not in master: alternative names both ways. Colombian grid addresses: "Cra 101 # 73A-29",
             "Cl 8a"; OSM names are "Carrera 101", "Calle 8A". "Carrera" has one reverse form "cra"; "Calle" keeps
             the reverse form "c" of rules_es.xml and gets "cl" by its word in a group (?:…), a from of its own. -->
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])cra(?![\p{L}\p{M}\p{N}])\.?" to="Carrera"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])kra(?![\p{L}\p{M}\p{N}])\.?" to="Carrera"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])cr(?![\p{L}\p{M}\p{N}])\.?" to="Carrera"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])kr(?![\p{L}\p{M}\p{N}])\.?" to="Carrera"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])carrera(?![\p{L}\p{M}\p{N}])" to="cra"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])cl(?![\p{L}\p{M}\p{N}])\.?" to="Calle"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])cll(?![\p{L}\p{M}\p{N}])\.?" to="Calle"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])(?:calle)(?![\p{L}\p{M}\p{N}])" to="cl"/>
    </index>
</rules>
