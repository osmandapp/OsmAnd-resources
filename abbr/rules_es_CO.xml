<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- Colombian grid addresses: "Cra 101 # 73A-29", "Cl 8a"; OSM names are "Carrera 101", "Calle 8A". -->
        <rule from="cra" to="Carrera" object="street"/>
        <rule from="kra" to="Carrera" object="street"/>
        <rule from="cr" to="Carrera" object="street"/>
        <rule from="kr" to="Carrera" object="street"/>
        <rule from="cl" to="Calle" object="street"/>
        <rule from="cll" to="Calle" object="street"/>
    </query>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="Registraduría" tags="office=government + government=register_office"/>
        <service word="SENA" tags="amenity=college" name="\bSENA\b|\bServicio\ Nacional\ de\ Aprendizaje\b"/>
    </poi>
</rules>
