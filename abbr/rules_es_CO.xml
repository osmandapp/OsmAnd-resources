<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
        <query>
        <!-- Colombian grid addresses: "Cra 101 # 73A-29", "Cl 8a"; OSM names are "Carrera 101", "Calle 8A". -->
        <rule object="street" from="(?iu)^(Cra|Kra|Cr|Kr)\.?$" to="Carrera"/>
        <rule object="street" from="(?iu)^(Cl|Cll)\.?$" to="Calle"/>
    </query>
</rules>
