<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="ASADA" tags="office=water_utility" name="\bASADA\b|\bAsociación\ Administradora\ del\ Sistema\ de\ Acueductos\ y\ Alcantarillados\ Comunales\b"/>
        <service word="CCSS" tags="amenity=clinic | amenity=hospital" name="\bCCSS\b"/>
        <service word="CCSS" tags="office=government" name="\bCCSS\b|\bCaja\ Costarricense\ de\ Seguro\ Social\b"/>
        <service word="CEN" tags="amenity=childcare" name="\bCEN\b|\bCentro\ de\ Educación\ y\ Nutrición\b"/>
        <service word="CINAI" tags="amenity=childcare" name="\bCINAI\b|\bCentros\ Infantiles\ de\ Nutrición\ y\ Atención\ Integral\b"/>
        <service word="EBAIS" tags="amenity=clinic" name="\bEBAIS\b|\bEquipo\ Básico\ de\ Atención\ Integral\ de\ Salud\b"/>
        <service word="MINAE" tags="office=government" name="\bMINAE\b|\bMinisterio\ de\ Ambiente\ y\ Energía\b"/>
        <service word="OIJ" tags="amenity=police" name="\bOIJ\b|\bOrganismo\ de\ Investigación\ Judicial\b"/>
        <service word="PANI" tags="office=government" name="\bPANI\b|\bPatronato\ Nacional\ de\ la\ Infancia\b"/>
    </poi>
</rules>
