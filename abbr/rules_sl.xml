<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="GRS" full="Gorska reševalna služba"/>
        <abbr short="LD" full="Lovska družina"/>
        <abbr short="OŠ" full="Osnovna šola"/>
        <abbr short="PGD" full="Prostovoljno gasilsko društvo"/>
        <abbr short="PZA" full="Postajališče za avtodome"/>
        <brand value="Triglav" tags="office=insurance"/>
    </poi>
</rules>
