<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGRS\E(?![\p{L}\p{M}\p{N}])\.?" to="Gorska reševalna služba"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGorska reševalna služba\E(?![\p{L}\p{M}\p{N}])" to="GRS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLD\E(?![\p{L}\p{M}\p{N}])\.?" to="Lovska družina"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QLovska družina\E(?![\p{L}\p{M}\p{N}])" to="LD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOŠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Osnovna šola"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOsnovna šola\E(?![\p{L}\p{M}\p{N}])" to="OŠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPGD\E(?![\p{L}\p{M}\p{N}])\.?" to="Prostovoljno gasilsko društvo"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QProstovoljno gasilsko društvo\E(?![\p{L}\p{M}\p{N}])" to="PGD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPZA\E(?![\p{L}\p{M}\p{N}])\.?" to="Postajališče za avtodome"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPostajališče za avtodome\E(?![\p{L}\p{M}\p{N}])" to="PZA"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Triglav" tags="office=insurance"/>
    </poi>
</rules>
