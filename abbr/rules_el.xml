<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="ΓΕΛ" full="Γενικό Λύκειο"/>
        <abbr short="ΕΠΑΛ" full="Επαγγελματικό Λύκειο"/>
        <abbr short="ΚΑΠΗ" full="Κέντρο Ανοιχτής Προστασίας Ηλικιωμένων"/>
        <abbr short="ΚΕΠ" full="Κέντρο Εξυπηρέτησης Πολιτών"/>
        <abbr short="ΚΤΕΛ" full="Κοινό Ταμείο Εισπράξεων Λεωφορείων"/>
        <brand value="Alterlife" tags="leisure=fitness_centre"/>
        <brand value="Goody's" tags="amenity=fast_food"/>
        <brand value="ΑΒ" tags="shop=supermarket"/>
        <brand value="Κωτσόβολος" tags="shop=electronics"/>
    </poi>
</rules>
