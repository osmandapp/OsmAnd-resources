<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΓΕΛ\E(?![\p{L}\p{M}\p{N}])\.?" to="Γενικό Λύκειο"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΓενικό Λύκειο\E(?![\p{L}\p{M}\p{N}])" to="ΓΕΛ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΕΠΑΛ\E(?![\p{L}\p{M}\p{N}])\.?" to="Επαγγελματικό Λύκειο"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΕπαγγελματικό Λύκειο\E(?![\p{L}\p{M}\p{N}])" to="ΕΠΑΛ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚΑΠΗ\E(?![\p{L}\p{M}\p{N}])\.?" to="Κέντρο Ανοιχτής Προστασίας Ηλικιωμένων"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚέντρο Ανοιχτής Προστασίας Ηλικιωμένων\E(?![\p{L}\p{M}\p{N}])" to="ΚΑΠΗ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚΕΠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Κέντρο Εξυπηρέτησης Πολιτών"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚέντρο Εξυπηρέτησης Πολιτών\E(?![\p{L}\p{M}\p{N}])" to="ΚΕΠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚΤΕΛ\E(?![\p{L}\p{M}\p{N}])\.?" to="Κοινό Ταμείο Εισπράξεων Λεωφορείων"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QΚοινό Ταμείο Εισπράξεων Λεωφορείων\E(?![\p{L}\p{M}\p{N}])" to="ΚΤΕΛ"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Alterlife" tags="leisure=fitness_centre"/>
        <brand value="Goody&#x27;s" tags="amenity=fast_food"/>
        <brand value="ΑΒ" tags="shop=supermarket"/>
        <brand value="Κωτσόβολος" tags="shop=electronics"/>
    </poi>
</rules>
