<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <index>
        <!-- #26691: Canada Post writes "10720 56 AVE NW" and users type "56ave"; a numbered street gets the number
             glued to its type as an alternative name. Ordinals ("1st Avenue") have no space after the digits; "1 Street"
             is not glued: "1St" would be the ordinal "1st" (21, 31... too, 11 is "11th") -->
        <rule object="street" from="(?iu)\b(\d+)\s+(?:Avenue|Ave)\b" to="$1Avenue"/>
        <rule object="street" from="(?iu)\b(\d+)\s+(?:Avenue|Ave)\.?(?=\s|$)" to="$1Ave"/>
        <rule object="street" from="(?iu)\b(\d+)\s+(?:Avenue|Ave|Av)\.?(?=\s|$)" to="$1Av"/>
        <rule object="street" from="(?iu)\b(\d*[02-9]|\d*11)\s+(?:Street|St)\b" to="$1Street"/>
        <rule object="street" from="(?iu)\b(\d*[02-9]|\d*11)\s+(?:Street|St)\.?(?=\s|$)" to="$1St"/>
    </index>
    <poi>
        <service word="CLSC" tags="amenity=clinic" name="\bCLSC\b|\bCentre\ local\ de\ services\ communautaires\b"/>
        <service word="RCMP" tags="amenity=police" name="\bRCMP\b|\bRoyal\ Canadian\ Mounted\ Police\b"/>
    </poi>
</rules>
