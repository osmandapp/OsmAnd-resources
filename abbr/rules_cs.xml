<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="HZS" full="Hasičský záchranný sbor"/>
        <abbr short="MŠ" full="Mateřská škola"/>
        <abbr short="NPP" full="Národní přírodní památka"/>
        <abbr short="PP" full="Přírodní památka"/>
        <abbr short="SDH" full="Sbor dobrovolných hasičů"/>
        <abbr short="SOU" full="Střední odborné učiliště"/>
        <abbr short="SOŠ" full="Střední odborná škola"/>
        <abbr short="STK" full="Stanice technické kontroly"/>
        <abbr short="TJ" full="Tělovýchovná jednota"/>
        <abbr short="ZUŠ" full="Základní umělecká škola"/>
        <abbr short="ZŠ" full="Základní škola"/>
        <abbr short="ČMS" full="Sdružení hasičů Čech, Moravy a Slezska"/>
        <brand value="Enapo" tags="shop=convenience"/>
        <brand value="Prona" tags="amenity=fuel"/>
    </poi>
</rules>
