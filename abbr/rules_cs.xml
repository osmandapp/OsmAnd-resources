<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QHZS\E(?![\p{L}\p{M}\p{N}])\.?" to="Hasičský záchranný sbor"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QHasičský záchranný sbor\E(?![\p{L}\p{M}\p{N}])" to="HZS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QMŠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Mateřská škola"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QMateřská škola\E(?![\p{L}\p{M}\p{N}])" to="MŠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNPP\E(?![\p{L}\p{M}\p{N}])\.?" to="Národní přírodní památka"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNárodní přírodní památka\E(?![\p{L}\p{M}\p{N}])" to="NPP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPP\E(?![\p{L}\p{M}\p{N}])\.?" to="Přírodní památka"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPřírodní památka\E(?![\p{L}\p{M}\p{N}])" to="PP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSDH\E(?![\p{L}\p{M}\p{N}])\.?" to="Sbor dobrovolných hasičů"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSbor dobrovolných hasičů\E(?![\p{L}\p{M}\p{N}])" to="SDH"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSOU\E(?![\p{L}\p{M}\p{N}])\.?" to="Střední odborné učiliště"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QStřední odborné učiliště\E(?![\p{L}\p{M}\p{N}])" to="SOU"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSOŠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Střední odborná škola"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QStřední odborná škola\E(?![\p{L}\p{M}\p{N}])" to="SOŠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSTK\E(?![\p{L}\p{M}\p{N}])\.?" to="Stanice technické kontroly"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QStanice technické kontroly\E(?![\p{L}\p{M}\p{N}])" to="STK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTJ\E(?![\p{L}\p{M}\p{N}])\.?" to="Tělovýchovná jednota"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTělovýchovná jednota\E(?![\p{L}\p{M}\p{N}])" to="TJ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZUŠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Základní umělecká škola"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZákladní umělecká škola\E(?![\p{L}\p{M}\p{N}])" to="ZUŠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZŠ\E(?![\p{L}\p{M}\p{N}])\.?" to="Základní škola"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZákladní škola\E(?![\p{L}\p{M}\p{N}])" to="ZŠ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QČMS\E(?![\p{L}\p{M}\p{N}])\.?" to="Sdružení hasičů Čech, Moravy a Slezska"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSdružení hasičů Čech, Moravy a Slezska\E(?![\p{L}\p{M}\p{N}])" to="ČMS"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Enapo" tags="shop=convenience"/>
        <brand value="Prona" tags="amenity=fuel"/>
    </poi>
</rules>
