<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="IPD" full="Ibu Pejabat Polis Daerah"/>
        <abbr short="SJK" full="Sekolah Jenis Kebangsaan"/>
        <abbr short="SMJK" full="Sekolah Menengah Jenis Kebangsaan"/>
        <abbr short="SMK" full="Sekolah Menengah Kebangsaan"/>
        <brand value="Alpro" tags="amenity=pharmacy"/>
        <brand value="Laundrybar" tags="shop=laundry"/>
        <brand value="Mediviron" tags="amenity=clinic"/>
    </poi>
</rules>
