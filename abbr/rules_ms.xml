<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIPD\E(?![\p{L}\p{M}\p{N}])\.?" to="Ibu Pejabat Polis Daerah"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QIbu Pejabat Polis Daerah\E(?![\p{L}\p{M}\p{N}])" to="IPD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSJK\E(?![\p{L}\p{M}\p{N}])\.?" to="Sekolah Jenis Kebangsaan"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSekolah Jenis Kebangsaan\E(?![\p{L}\p{M}\p{N}])" to="SJK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSMJK\E(?![\p{L}\p{M}\p{N}])\.?" to="Sekolah Menengah Jenis Kebangsaan"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSekolah Menengah Jenis Kebangsaan\E(?![\p{L}\p{M}\p{N}])" to="SMJK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSMK\E(?![\p{L}\p{M}\p{N}])\.?" to="Sekolah Menengah Kebangsaan"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSekolah Menengah Kebangsaan\E(?![\p{L}\p{M}\p{N}])" to="SMK"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Alpro" tags="amenity=pharmacy"/>
        <brand value="Laundrybar" tags="shop=laundry"/>
        <brand value="Mediviron" tags="amenity=clinic"/>
    </poi>
</rules>
