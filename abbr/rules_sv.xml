<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QEFS\E(?![\p{L}\p{M}\p{N}])\.?" to="Evangeliska Fosterlands-Stiftelsen"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QEvangeliska Fosterlands-Stiftelsen\E(?![\p{L}\p{M}\p{N}])" to="EFS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QFBK\E(?![\p{L}\p{M}\p{N}])\.?" to="Frivillig brandkår"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QFrivillig brandkår\E(?![\p{L}\p{M}\p{N}])" to="FBK"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="POP" tags="amenity=bank"/>
    </poi>
</rules>
