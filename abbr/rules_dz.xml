<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QBHU\E(?![\p{L}\p{M}\p{N}])\.?" to="Basic Health Unit"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QBasic Health Unit\E(?![\p{L}\p{M}\p{N}])" to="BHU"/>
    </index>
</rules>
