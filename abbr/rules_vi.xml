<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="CDM" full="Cash Deposit Machine"/>
        <abbr short="CF" full="Cà phê"/>
        <abbr short="CH" full="Cửa hàng"/>
        <abbr short="CHXD" full="Cửa hàng xăng dầu"/>
        <abbr short="CRM" full="Cash Recycling Machine"/>
        <abbr short="HĐND" full="Hội đồng nhân dân"/>
        <abbr short="PCCC" full="Phòng cháy chữa cháy"/>
        <abbr short="QT" full="Quầy thuốc"/>
        <abbr short="THCS" full="Trung học cơ sở"/>
        <abbr short="THPT" full="Trung học phổ thông"/>
        <abbr short="UBND" full="Ủy ban nhân dân"/>
        <brand value="Co.opmart" tags="shop=supermarket"/>
        <brand value="TH true mart" tags="shop=convenience"/>
    </poi>
</rules>
