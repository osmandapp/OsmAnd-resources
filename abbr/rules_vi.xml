<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCDM\E(?![\p{L}\p{M}\p{N}])\.?" to="Cash Deposit Machine"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCash Deposit Machine\E(?![\p{L}\p{M}\p{N}])" to="CDM"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCF\E(?![\p{L}\p{M}\p{N}])\.?" to="Cà phê"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCà phê\E(?![\p{L}\p{M}\p{N}])" to="CF"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCH\E(?![\p{L}\p{M}\p{N}])\.?" to="Cửa hàng"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCửa hàng\E(?![\p{L}\p{M}\p{N}])" to="CH"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCHXD\E(?![\p{L}\p{M}\p{N}])\.?" to="Cửa hàng xăng dầu"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCửa hàng xăng dầu\E(?![\p{L}\p{M}\p{N}])" to="CHXD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCRM\E(?![\p{L}\p{M}\p{N}])\.?" to="Cash Recycling Machine"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCash Recycling Machine\E(?![\p{L}\p{M}\p{N}])" to="CRM"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QHĐND\E(?![\p{L}\p{M}\p{N}])\.?" to="Hội đồng nhân dân"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QHội đồng nhân dân\E(?![\p{L}\p{M}\p{N}])" to="HĐND"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPCCC\E(?![\p{L}\p{M}\p{N}])\.?" to="Phòng cháy chữa cháy"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPhòng cháy chữa cháy\E(?![\p{L}\p{M}\p{N}])" to="PCCC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QQT\E(?![\p{L}\p{M}\p{N}])\.?" to="Quầy thuốc"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QQuầy thuốc\E(?![\p{L}\p{M}\p{N}])" to="QT"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTHCS\E(?![\p{L}\p{M}\p{N}])\.?" to="Trung học cơ sở"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTrung học cơ sở\E(?![\p{L}\p{M}\p{N}])" to="THCS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTHPT\E(?![\p{L}\p{M}\p{N}])\.?" to="Trung học phổ thông"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QTrung học phổ thông\E(?![\p{L}\p{M}\p{N}])" to="THPT"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QUBND\E(?![\p{L}\p{M}\p{N}])\.?" to="Ủy ban nhân dân"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QỦy ban nhân dân\E(?![\p{L}\p{M}\p{N}])" to="UBND"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Co.opmart" tags="shop=supermarket"/>
        <brand value="TH true mart" tags="shop=convenience"/>
    </poi>
</rules>
