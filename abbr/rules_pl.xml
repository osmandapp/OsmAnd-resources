<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- "Powstańców Śląskich 124 paw. 200": a market pavilion, a part of the house number; "paw." alone matched
             "Paweł" in names. -->
        <rule from="paw" object="building"/>
    </query>
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="FUP" full="Filia Urzędu Pocztowego"/>
        <abbr short="GOPR" full="Górskie Ochotnicze Pogotowie Ratunkowe"/>
        <abbr short="KSRG" full="Krajowy System Ratowniczo-Gaśniczy"/>
        <abbr short="NZOZ" full="Niepubliczny Zakład Opieki Zdrowotnej"/>
        <abbr short="OSK" full="Ośrodek Szkolenia Kierowców"/>
        <abbr short="OSP" full="Ochotnicza Straż Pożarna"/>
        <abbr short="PCW" full="Punkt czerpania wody"/>
        <abbr short="PKS" full="Państwowa Komunikacja Samochodowa"/>
        <abbr short="POZ" full="Podstawowa opieka zdrowotna"/>
        <abbr short="PSP" full="Państwowa Straż Pożarna"/>
        <abbr short="PTTK" full="Polskie Towarzystwo Turystyczno-Krajoznawcze"/>
        <abbr short="RCKiK" full="Regionalne Centrum Krwiodawstwa i Krwiolecznictwa"/>
        <abbr short="SKOK" full="Spółdzielcza Kasa Oszczędnościowo-Kredytowa"/>
        <abbr short="SOR" full="Szpitalny Oddział Ratunkowy"/>
        <brand value="Abra" tags="shop=furniture"/>
        <brand value="Bitomat" tags="amenity=atm"/>
        <brand value="BKF" tags="amenity=car_wash"/>
        <brand value="Hestia" tags="office=insurance"/>
        <brand value="Hitpol" tags="shop=convenience"/>
        <brand value="Kaes" tags="shop=clothes"/>
        <brand value="Kakadu" tags="shop=pet"/>
        <brand value="Kodano" tags="shop=optician"/>
        <brand value="PGE" tags="office=company"/>
        <brand value="Pofam" tags="shop=medical_supply"/>
        <brand value="PSS" tags="shop=convenience | shop=supermarket"/>
        <brand value="Remedium" tags="amenity=pharmacy"/>
        <brand value="SFD" tags="shop=nutrition_supplements"/>
        <brand value="Sphinx" tags="amenity=restaurant"/>
        <brand value="Travelplanet" tags="shop=travel_agency"/>
        <brand value="Zdrowit" tags="amenity=pharmacy"/>
        <brand value="Zyguła" tags="shop=butcher"/>
    </poi>
</rules>
