<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- "Powstańców Śląskich 124 paw. 200": a market pavilion, a part of the house number; "paw." alone matched
             "Paweł" in names. -->
        <rule from="paw" object="building"/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QFUP\E(?![\p{L}\p{M}\p{N}])\.?" to="Filia Urzędu Pocztowego"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QFilia Urzędu Pocztowego\E(?![\p{L}\p{M}\p{N}])" to="FUP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGOPR\E(?![\p{L}\p{M}\p{N}])\.?" to="Górskie Ochotnicze Pogotowie Ratunkowe"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGórskie Ochotnicze Pogotowie Ratunkowe\E(?![\p{L}\p{M}\p{N}])" to="GOPR"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QKSRG\E(?![\p{L}\p{M}\p{N}])\.?" to="Krajowy System Ratowniczo-Gaśniczy"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QKrajowy System Ratowniczo-Gaśniczy\E(?![\p{L}\p{M}\p{N}])" to="KSRG"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNZOZ\E(?![\p{L}\p{M}\p{N}])\.?" to="Niepubliczny Zakład Opieki Zdrowotnej"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNiepubliczny Zakład Opieki Zdrowotnej\E(?![\p{L}\p{M}\p{N}])" to="NZOZ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOSK\E(?![\p{L}\p{M}\p{N}])\.?" to="Ośrodek Szkolenia Kierowców"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOśrodek Szkolenia Kierowców\E(?![\p{L}\p{M}\p{N}])" to="OSK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOSP\E(?![\p{L}\p{M}\p{N}])\.?" to="Ochotnicza Straż Pożarna"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOchotnicza Straż Pożarna\E(?![\p{L}\p{M}\p{N}])" to="OSP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPCW\E(?![\p{L}\p{M}\p{N}])\.?" to="Punkt czerpania wody"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPunkt czerpania wody\E(?![\p{L}\p{M}\p{N}])" to="PCW"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPKS\E(?![\p{L}\p{M}\p{N}])\.?" to="Państwowa Komunikacja Samochodowa"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPaństwowa Komunikacja Samochodowa\E(?![\p{L}\p{M}\p{N}])" to="PKS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPOZ\E(?![\p{L}\p{M}\p{N}])\.?" to="Podstawowa opieka zdrowotna"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPodstawowa opieka zdrowotna\E(?![\p{L}\p{M}\p{N}])" to="POZ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPSP\E(?![\p{L}\p{M}\p{N}])\.?" to="Państwowa Straż Pożarna"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPaństwowa Straż Pożarna\E(?![\p{L}\p{M}\p{N}])" to="PSP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPTTK\E(?![\p{L}\p{M}\p{N}])\.?" to="Polskie Towarzystwo Turystyczno-Krajoznawcze"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QPolskie Towarzystwo Turystyczno-Krajoznawcze\E(?![\p{L}\p{M}\p{N}])" to="PTTK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRCKiK\E(?![\p{L}\p{M}\p{N}])\.?" to="Regionalne Centrum Krwiodawstwa i Krwiolecznictwa"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QRegionalne Centrum Krwiodawstwa i Krwiolecznictwa\E(?![\p{L}\p{M}\p{N}])" to="RCKiK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSKOK\E(?![\p{L}\p{M}\p{N}])\.?" to="Spółdzielcza Kasa Oszczędnościowo-Kredytowa"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSpółdzielcza Kasa Oszczędnościowo-Kredytowa\E(?![\p{L}\p{M}\p{N}])" to="SKOK"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSOR\E(?![\p{L}\p{M}\p{N}])\.?" to="Szpitalny Oddział Ratunkowy"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSzpitalny Oddział Ratunkowy\E(?![\p{L}\p{M}\p{N}])" to="SOR"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Abra" tags="shop=furniture"/>
        <brand value="Bitomat" tags="amenity=atm"/>
        <brand value="BKF" tags="amenity=car_wash"/>
        <brand value="Hestia" tags="office=insurance"/>
        <brand value="Hitpol" tags="shop=convenience"/>
        <brand value="Kaes" tags="shop=clothes"/>
        <brand value="Kakadu" tags="shop=pet"/>
        <brand value="Kodano" tags="shop=optician"/>
        <brand value="PGE" tags="office=company"/>
        <brand value="Pofam" tags="shop=medical_supply"/>
        <brand value="PSS" tags="shop=convenience | shop=supermarket"/>
        <brand value="Remedium" tags="amenity=pharmacy"/>
        <brand value="SFD" tags="shop=nutrition_supplements"/>
        <brand value="Sphinx" tags="amenity=restaurant"/>
        <brand value="Travelplanet" tags="shop=travel_agency"/>
        <brand value="Zdrowit" tags="amenity=pharmacy"/>
        <brand value="Zyguła" tags="shop=butcher"/>
    </poi>
</rules>
