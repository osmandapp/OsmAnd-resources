<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- query.db: "вул. Хоткевича, 144", "пров. Харківський 11", "Івано-Франківська обл."; OSM names keep the
             full word. Users on Ukrainian maps also type the Russian "ул." (as often as "вул."): the name is Ukrainian
             ("вулиця"), its name:ru is Russian ("улица"). -->
        <rule from="вул" to="Вулиця"/>
        <rule from="ул"><to>Вулиця</to><to>Улица</to></rule>
        <rule from="просп" to="Проспект" object="street"/>
        <rule from="пров" to="Провулок" object="street"/>
        <rule from="обл" to="Область" object="boundary"/>
        <rule from="кв" object="building"/>
        <!-- "21/19, 26 поверх": a floor, a part of the house number; alone it matched "Критий ринок, 2 поверх" 55 km away. -->
        <rule from="поверх" object="building"/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАГЗС\E(?![\p{L}\p{M}\p{N}])\.?" to="Автомобільна газозаправна станція"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАвтомобільна газозаправна станція\E(?![\p{L}\p{M}\p{N}])" to="АГЗС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАГНКС\E(?![\p{L}\p{M}\p{N}])\.?" to="Автомобільна газонаповнювальна компресорна станція"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАвтомобільна газонаповнювальна компресорна станція\E(?![\p{L}\p{M}\p{N}])" to="АГНКС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАЗПСМ\E(?![\p{L}\p{M}\p{N}])\.?" to="Амбулаторія загальної практики сімейної медицини"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАмбулаторія загальної практики сімейної медицини\E(?![\p{L}\p{M}\p{N}])" to="АЗПСМ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QВПЗ\E(?![\p{L}\p{M}\p{N}])\.?" to="Відділення поштового зв&#x27;язку"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QВідділення поштового зв&#x27;язку\E(?![\p{L}\p{M}\p{N}])" to="ВПЗ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QГУНП\E(?![\p{L}\p{M}\p{N}])\.?" to="Головне управління Національної поліції"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QГоловне управління Національної поліції\E(?![\p{L}\p{M}\p{N}])" to="ГУНП"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДНЗ\E(?![\p{L}\p{M}\p{N}])\.?" to="Дошкільний навчальний заклад"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДошкільний навчальний заклад\E(?![\p{L}\p{M}\p{N}])" to="ДНЗ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДОТ\E(?![\p{L}\p{M}\p{N}])\.?" to="Довготривала оборонна точка"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДовготривала оборонна точка\E(?![\p{L}\p{M}\p{N}])" to="ДОТ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДОЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Дитячий оздоровчий центр"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДитячий оздоровчий центр\E(?![\p{L}\p{M}\p{N}])" to="ДОЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДПРЧ\E(?![\p{L}\p{M}\p{N}])\.?" to="Державна пожежно-рятувальна частина"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДержавна пожежно-рятувальна частина\E(?![\p{L}\p{M}\p{N}])" to="ДПРЧ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДСНС\E(?![\p{L}\p{M}\p{N}])\.?" to="Державна служба України з надзвичайних ситуацій"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДержавна служба України з надзвичайних ситуацій\E(?![\p{L}\p{M}\p{N}])" to="ДСНС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДЮСШ\E(?![\p{L}\p{M}\p{N}])\.?" to="Дитячо-юнацька спортивна школа"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДитячо-юнацька спортивна школа\E(?![\p{L}\p{M}\p{N}])" to="ДЮСШ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗДО\E(?![\p{L}\p{M}\p{N}])\.?" to="Заклад дошкільної освіти"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗаклад дошкільної освіти\E(?![\p{L}\p{M}\p{N}])" to="ЗДО"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗЗСО\E(?![\p{L}\p{M}\p{N}])\.?" to="Заклад загальної середньої освіти"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗаклад загальної середньої освіти\E(?![\p{L}\p{M}\p{N}])" to="ЗЗСО"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗОШ\E(?![\p{L}\p{M}\p{N}])\.?" to="Загальноосвітня школа"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗагальноосвітня школа\E(?![\p{L}\p{M}\p{N}])" to="ЗОШ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗПСМ\E(?![\p{L}\p{M}\p{N}])\.?" to="Загальна практика - сімейна медицина"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗагальна практика - сімейна медицина\E(?![\p{L}\p{M}\p{N}])" to="ЗПСМ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QНВК\E(?![\p{L}\p{M}\p{N}])\.?" to="Навчально-виховний комплекс"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QНавчально-виховний комплекс\E(?![\p{L}\p{M}\p{N}])" to="НВК"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПТУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Професійно-технічне училище"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПрофесійно-технічне училище\E(?![\p{L}\p{M}\p{N}])" to="ПТУ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПЦУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Православна церква України"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПравославна церква України\E(?![\p{L}\p{M}\p{N}])" to="ПЦУ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРДА\E(?![\p{L}\p{M}\p{N}])\.?" to="Районна державна адміністрація"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРайонна державна адміністрація\E(?![\p{L}\p{M}\p{N}])" to="РДА"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРПЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Російська православна церква"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРосійська православна церква\E(?![\p{L}\p{M}\p{N}])" to="РПЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСЗШ\E(?![\p{L}\p{M}\p{N}])\.?" to="Середня загальноосвітня школа"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСередня загальноосвітня школа\E(?![\p{L}\p{M}\p{N}])" to="СЗШ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТРЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Торговельно-розважальний центр"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТорговельно-розважальний центр\E(?![\p{L}\p{M}\p{N}])" to="ТРЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТСОУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Товариство сприяння обороні України"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТовариство сприяння обороні України\E(?![\p{L}\p{M}\p{N}])" to="ТСОУ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Торговий центр"/>  <!-- also: Торгово-розважальний центр -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QТорговий центр\E(?![\p{L}\p{M}\p{N}])" to="ТЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QУГКЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Українська греко-католицька церква"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QУкраїнська греко-католицька церква\E(?![\p{L}\p{M}\p{N}])" to="УГКЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QУПЦ\E(?![\p{L}\p{M}\p{N}])\.?" to="Українська православна церква"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QУкраїнська православна церква\E(?![\p{L}\p{M}\p{N}])" to="УПЦ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФАП\E(?![\p{L}\p{M}\p{N}])\.?" to="Фельдшерсько-акушерський пункт"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФельдшерсько-акушерський пункт\E(?![\p{L}\p{M}\p{N}])" to="ФАП"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦНАП\E(?![\p{L}\p{M}\p{N}])\.?" to="Центр надання адміністративних послуг"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦентр надання адміністративних послуг\E(?![\p{L}\p{M}\p{N}])" to="ЦНАП"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦРЛ\E(?![\p{L}\p{M}\p{N}])\.?" to="Центральна районна лікарня"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦентральна районна лікарня\E(?![\p{L}\p{M}\p{N}])" to="ЦРЛ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЄХБ\E(?![\p{L}\p{M}\p{N}])\.?" to="Євангельські християни-баптисти"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЄвангельські християни-баптисти\E(?![\p{L}\p{M}\p{N}])" to="ЄХБ"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Avantage" tags="amenity=fuel"/>
        <brand value="Аваль" tags="amenity=bank | amenity=atm"/>
        <brand value="Агромол" tags="shop=dairy"/>
        <brand value="Везунчик" tags="shop=convenience"/>
        <brand value="Оптовичок" tags="shop=convenience"/>
        <brand value="Правекс" tags="amenity=bank"/>
    </poi>
</rules>
