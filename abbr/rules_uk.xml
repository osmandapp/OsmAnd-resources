<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
        <query>
        <!-- query.db: "вул. Хоткевича, 144", "пров. Харківський 11", "Івано-Франківська обл."; OSM names keep the
             full word. Users on Ukrainian maps also type the Russian "ул." (as often as "вул."): the name is Ukrainian
             ("вулиця"), its name:ru is Russian ("улица"). -->
        <rule from="вул" to="Вулиця"/>
        <rule from="ул" to="Вулиця"/>
        <rule from="ул" to="Улица"/>
        <rule object="street" from="(?iu)^Просп\.?$" to="Проспект"/>
        <rule object="street" from="(?iu)^Пров\.?$" to="Провулок"/>
        <rule object="boundary" from="(?iu)^Обл\.?$" to="Область"/>

        <rule object="building" from="кв"/>
    </query>
</rules>
