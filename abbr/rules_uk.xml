<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- query.db: "вул. Хоткевича, 144", "пров. Харківський 11", "Івано-Франківська обл."; OSM names keep the
             full word. Users on Ukrainian maps also type the Russian "ул." (as often as "вул."): the name is Ukrainian
             ("вулиця"), its name:ru is Russian ("улица"). -->
        <rule from="вул" to="Вулиця"/>
        <rule from="ул"><to>Вулиця</to><to>Улица</to></rule>
        <rule from="просп" to="Проспект" object="street"/>
        <rule from="пров" to="Провулок" object="street"/>
        <rule from="обл" to="Область" object="boundary"/>
        <rule from="кв" object="building"/>
        <!-- "21/19, 26 поверх": a floor, a part of the house number; alone it matched "Критий ринок, 2 поверх" 55 km away. -->
        <rule from="поверх" object="building"/>
    </query>
</rules>
