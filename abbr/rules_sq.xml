<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAMF\E(?![\p{L}\p{M}\p{N}])\.?" to="Ambulanta e Mjekësisë Familjare"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAmbulanta e Mjekësisë Familjare\E(?![\p{L}\p{M}\p{N}])" to="AMF"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QQMF\E(?![\p{L}\p{M}\p{N}])\.?" to="Qendra e Mjekësisë Familjare"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QQendra e Mjekësisë Familjare\E(?![\p{L}\p{M}\p{N}])" to="QMF"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSH\E(?![\p{L}\p{M}\p{N}])\.?" to="Shkolla"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QShkolla\E(?![\p{L}\p{M}\p{N}])" to="SH"/>
    </index>
</rules>
