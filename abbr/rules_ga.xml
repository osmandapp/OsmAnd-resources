<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGAA\E(?![\p{L}\p{M}\p{N}])\.?" to="Gaelic Athletic Association"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QGaelic Athletic Association\E(?![\p{L}\p{M}\p{N}])" to="GAA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNCT\E(?![\p{L}\p{M}\p{N}])\.?" to="National Car Test"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QNational Car Test\E(?![\p{L}\p{M}\p{N}])" to="NCT"/>
    </index>
</rules>
