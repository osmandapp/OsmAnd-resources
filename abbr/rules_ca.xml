<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <rule from="de" to=""/>
        <rule from="la" to=""/>
        <rule from="el" to=""/>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCEIP\E(?![\p{L}\p{M}\p{N}])\.?" to="Centro de Educación Infantil y Primaria"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCentro de Educación Infantil y Primaria\E(?![\p{L}\p{M}\p{N}])" to="CEIP"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCFA\E(?![\p{L}\p{M}\p{N}])\.?" to="Centre de Formació d&#x27;Adults"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCentre de Formació d&#x27;Adults\E(?![\p{L}\p{M}\p{N}])" to="CFA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QITV\E(?![\p{L}\p{M}\p{N}])\.?" to="Inspección Técnica de Vehículos"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QInspección Técnica de Vehículos\E(?![\p{L}\p{M}\p{N}])" to="ITV"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QSIAD\E(?![\p{L}\p{M}\p{N}])\.?" to="Servei d&#x27;Informació i Atenció a les Dones"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QServei d&#x27;Informació i Atenció a les Dones\E(?![\p{L}\p{M}\p{N}])" to="SIAD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZEC\E(?![\p{L}\p{M}\p{N}])\.?" to="Zona d&#x27;Especial Conservació"/>  <!-- also: Zona Especial de Conservación -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZona d&#x27;Especial Conservació\E(?![\p{L}\p{M}\p{N}])" to="ZEC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZEPA\E(?![\p{L}\p{M}\p{N}])\.?" to="Zona de Especial Protección para las Aves"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZona de Especial Protección para las Aves\E(?![\p{L}\p{M}\p{N}])" to="ZEPA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZER\E(?![\p{L}\p{M}\p{N}])\.?" to="Zona Escolar Rural"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QZona Escolar Rural\E(?![\p{L}\p{M}\p{N}])" to="ZER"/>
    </index>
</rules>
