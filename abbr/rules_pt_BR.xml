<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="CRAS" tags="amenity=social_facility" name="\bCRAS\b|\bCentro\ de\ Referência\ de\ Assistência\ Social\b"/>
        <service word="CREAS" tags="amenity=social_facility" name="\bCREAS\b|\bCentro\ de\ Referência\ Especializado\ de\ Assistência\ Social\b"/>
        <service word="ETEC" tags="amenity=college" name="\bETEC\b|\bEscola\ Técnica\ Estadual\b"/>
        <service word="INSS" tags="office=government" name="\bINSS\b|\bInstituto\ Nacional\ do\ Seguro\ Social\b" operator="\bINSS\b|\bInstituto\ Nacional\ do\ Seguro\ Social\b"/>
        <service word="PRF" tags="amenity=police" name="\bPRF\b|\bPolícia\ Rodoviária\ Federal\b" operator="\bPRF\b|\bPolícia\ Rodoviária\ Federal\b"/>
        <service word="SAMU" tags="emergency=ambulance_station" name="\bSAMU\b|\bServiço\ de\ Atendimento\ Móvel\ de\ Urgência\b" operator="\bSAMU\b"/>
        <service word="UPA" tags="amenity=clinic" name="\bUPA\b|\bUnidade\ de\ Pronto\ Atendimento\b"/>
    </poi>
</rules>
