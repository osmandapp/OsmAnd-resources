        <service word="ETEC" tags="amenity=college" name="\bETEC\b|\bEscola\ Técnica\ Estadual\b"/>
        <service word="INSS" tags="office=government" name="\bINSS\b|\bInstituto\ Nacional\ do\ Seguro\ Social\b"/>
        <service word="PRF" tags="amenity=police" name="\bPRF\b|\bPolícia\ Rodoviária\ Federal\b"/>
        <service word="SAMU" tags="emergency=ambulance_station" name="\bSAMU\b|\bServiço\ de\ Atendimento\ Móvel\ de\ Urgência\b"/>
        <service word="UPA" tags="amenity=clinic" name="\bUPA\b|\bUnidade\ de\ Pronto\ Atendimento\b"/>
    </poi>
</rules>
