<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="DSİ" tags="office=government" name="\bDSİ\b"/>
        <service word="PTT" tags="amenity=post_office" name="\bPTT\b|\bPosta\ ve\ Telgraf\ Teşkilatı\b"/>
        <service word="SGK" tags="office=government" name="\bSGK\b|\bSosyal\ Güvenlik\ Kurumu\b"/>
    </poi>
</rules>
