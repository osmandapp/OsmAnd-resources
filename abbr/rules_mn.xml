<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗДТГ\E(?![\p{L}\p{M}\p{N}])\.?" to="Засаг даргын тамгын газар"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЗасаг даргын тамгын газар\E(?![\p{L}\p{M}\p{N}])" to="ЗДТГ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QШТС\E(?![\p{L}\p{M}\p{N}])\.?" to="Шатахуун түгээх станц"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QШатахуун түгээх станц\E(?![\p{L}\p{M}\p{N}])" to="ШТС"/>
    </index>
</rules>
