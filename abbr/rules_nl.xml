    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Accent" tags="office=employment_agency"/>
        <brand value="Carteam" tags="shop=car_repair"/>
        <brand value="Fletcher" tags="tourism=hotel"/>
        <brand value="Kwik-Fit" tags="shop=car_repair"/>
        <brand value="Restaria" tags="amenity=fast_food"/>
        <brand value="Solidaris" tags="office=insurance | office=health_insurance"/>
