<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="CICPC" tags="amenity=police" name="\bCICPC\b|\bCuerpo\ de\ Investigaciones\ Científicas,\ Penales\ y\ Criminalísticas\b"/>
        <service word="GNB" tags="amenity=police" name="\bGNB\b|\bGuardia\ Nacional\ Bolivariana\b"/>
        <service word="IVSS" tags="amenity=hospital" name="\bIVSS\b|\bInstituto\ Venezolano\ de\ los\ Seguros\ Sociales\b"/>
    </poi>
</rules>
