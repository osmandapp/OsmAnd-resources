<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- Directions, street types and titles of names. OSM names keep their abbreviations ("E Main St"): the query
         word gets the full form, the full word gets the abbreviation as its reverse form. -->
    <query>
        <!-- a one-letter direction belongs to a street name; "E Street NW" is a letter -->
        <rule from="e" to="East" object="street"/>
        <rule from="w" to="West" object="street"/>
        <rule from="s" to="South" object="street"/>
        <rule from="n" to="North" object="street"/>
        <rule from="sw" to="Southwest"/>
        <rule from="se" to="Southeast"/>
        <rule from="nw" to="Northwest"/>
        <rule from="ne" to="Northeast"/>

        <rule from="ln" to="Lane"/>
        <!-- two meanings: the street type and the title ("Dr Martin Luther King Jr Blvd") -->
        <rule from="dr">
            <to object="street">Drive</to>
            <to>Doctor</to>
        </rule>
        <rule from="rd" to="Road"/>
        <rule from="av" to="Avenue"/>
        <rule from="ave" to="Avenue"/>
        <!-- two meanings: the street type and the title ("St Albert Way", "St Mary's Church") -->
        <rule from="st">
            <to object="street">Street</to>
            <to>Saint</to>
        </rule>
        <rule from="hwy" to="Highway"/>
        <rule from="blvd" to="Boulevard"/>

        <rule from="1st" to="First"/>
        <rule from="2nd" to="Second"/>
        <rule from="3rd" to="Third"/>
        <rule from="4th" to="Fourth"/>
        <rule from="5th" to="Fifth"/>
        <rule from="6th" to="Sixth"/>
        <rule from="7th" to="Seventh"/>

        <!-- A1: the short form matches only a street/locality. -->
        <rule from="pl" to="Place" object="street"/>
        <rule from="pkwy" to="Parkway" object="street"/>
        <rule from="expy" to="Expressway" object="street"/>
        <rule from="ct" to="Court" object="street"/>
        <rule from="cir" to="Circle" object="street"/>
        <rule from="ter" to="Terrace" object="street"/>
        <rule from="mt" to="Mount" object="locality,poi"/>
        <rule from="ft" to="Fort" object="locality,poi"/>

        <!-- A unit or floor qualifier is recognized as a number part, not a free name synonym. -->
        <rule from="bldg" object="building"/>
        <rule from="ste" object="building"/>
        <rule from="unt" object="building"/>
        <rule from="apt" object="building"/>
        <rule from="fl" object="building"/>
        <rule from="flr" object="building"/>
        <rule from="bsmt" object="building"/>

        <rule from="the" to=""/>
        <rule from="of" to=""/>
        <rule from="and" to=""/>
        <skipPenalty>e east w west s south n north sw southwest se southeast nw northwest ne northeast ln lane dr drive doctor
        rd road av avenue st street saint hwy highway blvd boulevard</skipPenalty>
    </query>
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="APHC" full="Additional Primary Health Centre"/>
        <abbr short="APMC" full="Agricultural Produce Market Committee"/>
        <abbr short="ARFF" full="Aircraft Rescue and Firefighting"/>
        <abbr short="BMV" full="Bureau of Motor Vehicles"/>
        <abbr short="BPHC" full="Block Primary Health Centre"/>
        <abbr short="CE" full="Church of England"/>
        <abbr short="CHC" full="Community Health Centre"/>
        <abbr short="CHSLD" full="Centre d'hébergement et de soins de longue durée"/>
        <abbr short="CLSC" full="Centre local de services communautaires"/>
        <abbr short="CPA" full="Certified Public Accountant"/>
        <abbr short="DGC" full="Disc Golf Course"/>
        <abbr short="DMD" full="Doctor of Dental Medicine"/>
        <abbr short="DMV" full="Department of Motor Vehicles"/>
        <abbr short="DPM" full="Doctor of Podiatric Medicine"/>
        <abbr short="ECD" full="Early Childhood Development"/>
        <abbr short="ECDE" full="Early Childhood Development Education"/>
        <abbr short="EMS" full="Emergency Medical Services"/>
        <abbr short="FD" full="Fire Department"/>
        <abbr short="HMP" full="His Majesty's Prison"/>  <!-- also: Her Majesty's Prison -->
        <abbr short="ITI" full="Industrial Training Institute"/>
        <abbr short="JCC" full="Jewish Community Center"/>
        <abbr short="JHS" full="Junior High School"/>
        <abbr short="LNR" full="Local Nature Reserve"/>
        <abbr short="LPO" full="Licensed Post Office"/>
        <abbr short="MRI" full="Magnetic Resonance Imaging"/>
        <abbr short="MUGA" full="Multi-Use Games Area"/>
        <abbr short="NNR" full="National Nature Reserve"/>
        <abbr short="NWR" full="National Wildlife Refuge"/>
        <abbr short="OBGYN" full="Obstetrics and Gynecology"/>
        <abbr short="PG" full="Paying Guest"/>
        <abbr short="PHC" full="Primary Health Centre"/>
        <abbr short="PU" full="Pre-University"/>
        <abbr short="RC" full="Roman Catholic"/>
        <abbr short="RCMP" full="Royal Canadian Mounted Police"/>
        <abbr short="RFS" full="Rural Fire Service"/>
        <abbr short="SPCA" full="Society for the Prevention of Cruelty to Animals"/>
        <abbr short="SSSI" full="Site of Special Scientific Interest"/>
        <abbr short="TAFE" full="Technical and Further Education"/>
        <abbr short="TCM" full="Traditional Chinese Medicine"/>
        <abbr short="UHC" full="Urban Health Centre"/>
        <abbr short="UPHC" full="Urban Primary Health Centre"/>
        <abbr short="VFD" full="Volunteer Fire Department"/>
        <abbr short="WMA" full="Wildlife Management Area"/>
        <abbr short="WMC" full="Working Men's Club"/>
    </poi>
</rules>
