<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
    <!-- Outside <index> and <query> a rule works on both sides: street names are rewritten ("E Main St" -> "East Main
         Street") and the query word gets the same form. Both forms are common words. -->
    <rule from="e" to="East" replace="true" common="true"/>
    <rule from="w" to="West" replace="true" common="true"/>
    <rule from="s" to="South" replace="true" common="true"/>
    <rule from="n" to="North" replace="true" common="true"/>
    <rule from="sw" to="Southwest" replace="true" common="true"/>
    <rule from="se" to="Southeast" replace="true" common="true"/>
    <rule from="nw" to="Northwest" replace="true" common="true"/>
    <rule from="ne" to="Northeast" replace="true" common="true"/>

    <rule from="ln" to="Lane" replace="true" common="true"/>
    <rule from="dr" to="Drive" replace="true" common="true"/>
    <rule from="rd" to="Road" replace="true" common="true"/>
    <rule from="av" to="Avenue" replace="true" common="true"/>
    <rule from="st" to="Street" replace="true" common="true"/>
    <rule from="hwy" to="Highway" replace="true" common="true"/>
    <rule from="blvd" to="Boulevard" replace="true" common="true"/>

    <query>
        <!-- A query word also has the forms of the rules above; these extend them: "st" is Street and Saint. -->
        <rule from="ave" to="Avenue"/>
        <rule from="st" to="Saint"/>
        <rule from="1st" to="First"/>
        <rule from="2nd" to="Second"/>
        <rule from="3rd" to="Third"/>
        <rule from="first" to="1st"/>
        <rule from="second" to="2nd"/>
        <rule from="third" to="3rd"/>
        <rule from="fourth" to="4th"/>
        <rule from="fifth" to="5th"/>
        <rule from="sixth" to="6th"/>
        <rule from="seventh" to="7th"/>

        <!-- A1: a pair is matched on one side only, here the query; the short form matches only a street/locality. -->
        <rule object="street" from="(?iu)^Pl\.?$" to="Place"/>
        <rule object="street" from="(?iu)^Pkwy\.?$" to="Parkway"/>
        <rule object="street" from="(?iu)^Ct\.?$" to="Court"/>
        <rule object="street" from="(?iu)^Cir\.?$" to="Circle"/>
        <rule object="street" from="(?iu)^Ter\.?$" to="Terrace"/>
        <rule object="locality" from="(?iu)^Mt\.?$" to="Mount"/>
        <rule object="locality" from="(?iu)^Ft\.?$" to="Fort"/>

        <!-- A unit or floor qualifier is recognized as a number part, not a free name synonym. -->
        <rule object="building" from="bldg"/>
        <rule object="building" from="ste"/>
        <rule object="building" from="unt"/>
        <rule object="building" from="apt"/>
        <rule object="building" from="fl"/>
        <rule object="building" from="flr"/>
        <rule object="building" from="bsmt"/>

        <rule from="the" to=""/>
        <rule from="of" to=""/>
        <rule from="and" to=""/>
    </query>
</rules>
