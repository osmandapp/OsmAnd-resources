<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- Directions, street types and titles of names. OSM names keep their abbreviations ("E Main St"): the query
         word gets the full form, the full word gets the abbreviation as its reverse form. -->

    <!-- Mirror pairs (rules-spec.md, 3.4): the pairs of the legacy search (master Abbreviations), a query form both
         ways for OBFs built before the index rules and alternative names both ways for new ones. -->
    <!-- a one-letter direction belongs to a street name; "E Street NW" is a letter -->
    <rule from="e" to="East" object="street"/>
    <rule from="w" to="West" object="street"/>
    <rule from="s" to="South" object="street"/>
    <rule from="n" to="North" object="street"/>
    <rule from="sw" to="Southwest"/>
    <rule from="se" to="Southeast"/>
    <rule from="nw" to="Northwest"/>
    <rule from="ne" to="Northeast"/>

    <rule from="ln" to="Lane"/>
    <rule from="rd" to="Road"/>
    <rule from="av" to="Avenue"/>
    <rule from="ave" to="Avenue"/>
    <rule from="hwy" to="Highway"/>
    <rule from="blvd" to="Boulevard"/>

    <rule from="1st" to="First"/>
    <rule from="2nd" to="Second"/>
    <rule from="3rd" to="Third"/>
    <rule from="4th" to="Fourth"/>
    <rule from="5th" to="Fifth"/>
    <rule from="6th" to="Sixth"/>
    <rule from="7th" to="Seventh"/>

    <index>
        <!-- A1: pairs that were not in master, alternative names both ways; the short form matches only a
             street/locality. -->
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])pl(?![\p{L}\p{M}\p{N}])\.?" to="Place"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])place(?![\p{L}\p{M}\p{N}])" to="pl"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])pkwy(?![\p{L}\p{M}\p{N}])\.?" to="Parkway"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])parkway(?![\p{L}\p{M}\p{N}])" to="pkwy"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])ct(?![\p{L}\p{M}\p{N}])\.?" to="Court"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])court(?![\p{L}\p{M}\p{N}])" to="ct"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])cir(?![\p{L}\p{M}\p{N}])\.?" to="Circle"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])circle(?![\p{L}\p{M}\p{N}])" to="cir"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])ter(?![\p{L}\p{M}\p{N}])\.?" to="Terrace"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])terrace(?![\p{L}\p{M}\p{N}])" to="ter"/>
        <rule object="locality" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])mt(?![\p{L}\p{M}\p{N}])\.?" to="Mount"/>
        <rule object="locality" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])mount(?![\p{L}\p{M}\p{N}])" to="mt"/>
        <rule object="locality" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])ft(?![\p{L}\p{M}\p{N}])\.?" to="Fort"/>
        <rule object="locality" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])fort(?![\p{L}\p{M}\p{N}])" to="ft"/>
    </index>

    <query>
        <!-- two meanings: the street type and the title ("Dr Martin Luther King Jr Blvd") -->
        <rule from="dr">
            <to object="street">Drive</to>
            <to>Doctor</to>
        </rule>
        <!-- two meanings: the street type and the title ("St Albert Way", "St Mary's Church") -->
        <rule from="st">
            <to object="street">Street</to>
            <to>Saint</to>
        </rule>

        <!-- A unit or floor qualifier is recognized as a number part, not a free name synonym. -->
        <rule from="bldg" object="building"/>
        <rule from="ste" object="building"/>
        <rule from="unt" object="building"/>
        <rule from="apt" object="building"/>
        <rule from="fl" object="building"/>
        <rule from="flr" object="building"/>
        <rule from="bsmt" object="building"/>

        <rule from="the" to=""/>
        <rule from="of" to=""/>
        <rule from="and" to=""/>
        <skipPenalty>e east w west s south n north sw southwest se southeast nw northwest ne northeast ln lane dr drive doctor
        rd road av avenue st street saint hwy highway blvd boulevard</skipPenalty>
    </query>
</rules>
