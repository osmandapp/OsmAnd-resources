<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCSDD\E(?![\p{L}\p{M}\p{N}])\.?" to="Ceļu satiksmes drošības direkcija"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCeļu satiksmes drošības direkcija\E(?![\p{L}\p{M}\p{N}])" to="CSDD"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVPVKAC\E(?![\p{L}\p{M}\p{N}])\.?" to="Valsts un pašvaldību vienotais klientu apkalpošanas centrs"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QValsts un pašvaldību vienotais klientu apkalpošanas centrs\E(?![\p{L}\p{M}\p{N}])" to="VPVKAC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QVUGD\E(?![\p{L}\p{M}\p{N}])\.?" to="Valsts ugunsdzēsības un glābšanas dienests"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QValsts ugunsdzēsības un glābšanas dienests\E(?![\p{L}\p{M}\p{N}])" to="VUGD"/>
    </index>
</rules>
