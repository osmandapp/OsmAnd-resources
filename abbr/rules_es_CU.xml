<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="OBE" tags="office=energy_supplier" name="\bOBE\b|\bOrganización\ Básica\ Eléctrica\b"/>
        <service word="ONAT" tags="office=government" name="\bONAT\b|\bOficina\ Nacional\ de\ Administración\ Tributaria\b"/>
        <service word="PCC" tags="office=political_party" name="\bPCC\b|\bPartido\ Comunista\ de\ Cuba\b"/>
        <service word="PNR" tags="amenity=police" name="\bPNR\b|\bPolicía\ Nacional\ Revolucionaria\b"/>
    </poi>
</rules>
