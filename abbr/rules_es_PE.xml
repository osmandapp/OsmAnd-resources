<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <index>
        <!-- A pair that was not in master: alternative names both ways. Peruvian street type: "Jr. Junín 1203"; OSM
             names are "Jirón Junín". -->
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])jr(?![\p{L}\p{M}\p{N}])\.?" to="Jirón"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])jirón(?![\p{L}\p{M}\p{N}])" to="jr"/>
    </index>
</rules>
