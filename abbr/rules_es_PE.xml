<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <query>
        <!-- Peruvian street type: "Jr. Junín 1203"; OSM names are "Jirón Junín". -->
        <rule from="jr" to="Jirón" object="street"/>
    </query>
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="EsSalud" tags="amenity=clinic | amenity=hospital" name="\bEsSalud\b" operator="\bEsSalud\b"/>
        <service word="PNP" tags="amenity=police" name="\bPNP\b|\bPolicía\ Nacional\ del\ Perú\b"/>
        <service word="RENIEC" tags="office=government" name="\bRENIEC\b|\bRegistro\ Nacional\ de\ Identificación\ y\ Estado\ Civil\b"/>
        <service word="SUNARP" tags="office=government" name="\bSUNARP\b|\bSuperintendencia\ Nacional\ de\ los\ Registros\ Públicos\b"/>
        <service word="SUNAT" tags="office=government + government=tax"/>
        <service word="SUNAT" tags="office=government" name="\bSUNAT\b|\bSuperintendencia\ Nacional\ de\ Aduanas\ y\ de\ Administración\ Tributaria\b"/>
        <service word="UGEL" tags="office=government" name="\bUGEL\b|\bUnidad\ de\ Gestión\ Educativa\ Local\b"/>
    </poi>
</rules>
