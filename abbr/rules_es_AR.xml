<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="AFIP" tags="office=government" name="\bAFIP\b|\bAdministración\ Federal\ de\ Ingresos\ Públicos\b"/>
        <service word="ANSES" tags="office=government + government=social_security"/>
        <service word="ANSES" tags="office=government" name="\bANSES\b|\bAdministración\ Nacional\ de\ la\ Seguridad\ Social\b"/>
        <service word="PAMI" tags="office=government" name="\bPAMI\b|\bPrograma\ de\ Atención\ Médica\ Integral\b"/>
        <service word="SAMCo" tags="amenity=hospital" name="\bSAMCo\b" operator="\bSAMCo\b"/>
    </poi>
</rules>
