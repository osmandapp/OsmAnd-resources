        <service word="ANSES" tags="office=government" name="\bANSES\b|\bAdministración\ Nacional\ de\ la\ Seguridad\ Social\b"/>
        <service word="PAMI" tags="office=government" name="\bPAMI\b|\bPrograma\ de\ Atención\ Médica\ Integral\b"/>
