<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAPC\E(?![\p{L}\p{M}\p{N}])\.?" to="Assemblée Populaire Communale"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QAssemblée Populaire Communale\E(?![\p{L}\p{M}\p{N}])" to="APC"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCEM\E(?![\p{L}\p{M}\p{N}])\.?" to="Collège d&#x27;Enseignement Moyen"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCollège d&#x27;Enseignement Moyen\E(?![\p{L}\p{M}\p{N}])" to="CEM"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCFPA\E(?![\p{L}\p{M}\p{N}])\.?" to="Centre de Formation Professionnelle et d&#x27;Apprentissage"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCentre de Formation Professionnelle et d&#x27;Apprentissage\E(?![\p{L}\p{M}\p{N}])" to="CFPA"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCNAS\E(?![\p{L}\p{M}\p{N}])\.?" to="Caisse Nationale des Assurances Sociales"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QCaisse Nationale des Assurances Sociales\E(?![\p{L}\p{M}\p{N}])" to="CNAS"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QEPSP\E(?![\p{L}\p{M}\p{N}])\.?" to="Établissement Public de Santé de Proximité"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QÉtablissement Public de Santé de Proximité\E(?![\p{L}\p{M}\p{N}])" to="EPSP"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Ansari" tags="amenity=bureau_de_change"/>
        <brand value="Aster" tags="amenity=pharmacy"/>
        <brand value="Barid" tags="amenity=bank"/>
        <brand value="Electromin" tags="amenity=charging_station"/>
        <brand value="Galadari" tags="amenity=driving_school"/>
        <brand value="Yateem" tags="shop=optician"/>
        <brand value="الرميزان" tags="shop=jewelry"/>
        <brand value="العثيم" tags="shop=supermarket"/>
        <brand value="الكريمي" tags="amenity=bank"/>
        <brand value="المها" tags="amenity=fuel"/>
        <brand value="الوعلان" tags="shop=car"/>
        <brand value="توتال" tags="amenity=fuel"/>
        <brand value="كارفور" tags="shop=supermarket"/>
        <brand value="كاريبو" tags="amenity=cafe"/>
        <brand value="كانتون" tags="amenity=fast_food"/>
        <brand value="كورك" tags="office=telecommunication"/>
        <brand value="لومي" tags="amenity=car_rental"/>
        <brand value="موبيل" tags="amenity=fuel"/>
    </poi>
</rules>
