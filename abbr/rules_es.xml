<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
        <query>
        <!-- Titles of names: "Calle Dr. Mata", "Av. Gral. Güemes"; both forms are common words of names. -->
        <rule from="dr" to="Doctor" common="true"/>
        <rule from="gral" to="General" common="true"/>
        <rule from="sta" to="Santa" common="true"/>
        <rule from="sto" to="Santo" common="true"/>

        <!-- query.db: the street type users shorten ("av. de la Playa", "c/ Bilbao", "ctra. Alcocer"); OSM names are full. -->
        <rule object="street" from="(?iu)^Av\.?$" to="Avenida"/>
        <rule object="street" from="(?iu)^Avda\.?$" to="Avenida"/>
        <rule object="street" from="(?iu)^C\.?$" to="Calle"/>
        <rule object="street" from="(?iu)^Ctra\.?$" to="Carretera"/>
        <rule object="street" from="(?iu)^Carr\.?$" to="Carretera"/>
        <rule object="street" from="(?iu)^Urb\.?$" to="Urbanización"/>

        <!-- house number suffix: "12 bis" -->
        <rule object="building" from="bis"/>

        <rule from="de" to=""/>
        <rule from="la" to=""/>
        <rule from="el" to=""/>
        <rule from="en" to=""/>
        <rule from="y" to=""/>
    </query>
</rules>
