<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- Titles of names: "Calle Dr. Mata", "Av. Gral. Güemes". -->
    <query>
        <rule from="dr" to="Doctor"/>
        <rule from="gral" to="General"/>
        <rule from="sta" to="Santa"/>
        <rule from="sto" to="Santo"/>
        <!-- query.db: the street type users shorten ("av. de la Playa", "c/ Bilbao", "ctra. Alcocer"); OSM names are full. -->
        <rule from="av" to="Avenida" object="street"/>
        <rule from="avda" to="Avenida" object="street"/>
        <!-- disabled: a one-letter form takes a house letter: "86 C Calle de Velázquez" lost the house -->
        <!-- <rule from="c" to="Calle" object="street"/> -->
        <rule from="ctra" to="Carretera" object="street"/>
        <rule from="carr" to="Carretera" object="street"/>
        <rule from="urb" to="Urbanización" object="street"/>
        <!-- house number suffix: "12 bis" -->
        <rule from="bis" object="building"/>
        <rule from="de" to=""/>
        <rule from="la" to=""/>
        <rule from="el" to=""/>
        <rule from="en" to=""/>
        <rule from="y" to=""/>
        <skipPenalty>dr doctor gral general sta santa sto santo</skipPenalty>
    </query>
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
