<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QOPG\E(?![\p{L}\p{M}\p{N}])\.?" to="Obiteljsko poljoprivredno gospodarstvo"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QObiteljsko poljoprivredno gospodarstvo\E(?![\p{L}\p{M}\p{N}])" to="OPG"/>
    </index>
</rules>
