<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
        <query>
        <!-- "St-Denis", "Ste-Foy": Saint and Sainte, never a street; common words of names as well -->
        <rule from="st" to="Saint" common="true"/>
        <rule from="ste" to="Sainte" common="true"/>

        <!-- query.db: the street type users shorten ("48 av. Gambetta", "rte de Certines"); OSM names are full. -->
        <rule object="street" from="(?iu)^Av\.?$" to="Avenue"/>
        <rule object="street" from="(?iu)^Bd\.?$" to="Boulevard"/>
        <rule object="street" from="(?iu)^Chem\.?$" to="Chemin"/>
        <rule object="street" from="(?iu)^Rte\.?$" to="Route"/>
        <rule object="street" from="(?iu)^Pl\.?$" to="Place"/>

        <!-- house number suffixes: "12 bis", "12ter" -->
        <rule object="building" from="bis"/>
        <rule object="building" from="ter"/>
        <rule object="building" from="quater"/>

        <rule from="de" to=""/>
        <rule from="du" to=""/>
        <rule from="la" to=""/>
        <rule from="le" to=""/>
        <rule from="et" to=""/>
    </query>
</rules>
