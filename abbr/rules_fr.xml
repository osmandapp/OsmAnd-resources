<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- "St-Denis", "Ste-Foy": Saint and Sainte, never a street. -->
    <query>
        <rule from="st" to="Saint"/>
        <rule from="ste" to="Sainte"/>
        <!-- query.db: the street type users shorten ("48 av. Gambetta", "rte de Certines"); OSM names are full. -->
        <rule from="av" to="Avenue" object="street"/>
        <rule from="bd" to="Boulevard" object="street"/>
        <rule from="chem" to="Chemin" object="street"/>
        <rule from="rte" to="Route" object="street"/>
        <rule from="pl" to="Place" object="street"/>
        <!-- house number suffixes: "12 bis", "12ter" -->
        <rule from="bis" object="building"/>
        <rule from="ter" object="building"/>
        <rule from="quater" object="building"/>
        <rule from="de" to=""/>
        <rule from="du" to=""/>
        <rule from="la" to=""/>
        <rule from="le" to=""/>
        <rule from="et" to=""/>
        <skipPenalty>st saint ste sainte</skipPenalty>
    </query>
