<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="CONAF" tags="office=government" name="\bCONAF\b|\bCorporación\ Nacional\ Forestal\b" operator="\bCONAF\b|\bCorporación\ Nacional\ Forestal\b"/>
        <service word="SAPU" tags="amenity=clinic" name="\bSAPU\b|\bServicio\ de\ Atención\ Primaria\ de\ Urgencia\b"/>
        <service word="SML" tags="amenity=mortuary" name="\bSML\b|\bServicio\ Médico\ Legal\b" operator="\bSML\b|\bServicio\ Médico\ Legal\b"/>
    </poi>
</rules>
