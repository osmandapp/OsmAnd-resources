<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <service word="CONAF" tags="office=government + government=public_service"/>
        <service word="SAPU" tags="amenity=clinic" name="\bSAPU\b|\bServicio\ de\ Atención\ Primaria\ de\ Urgencia\b"/>
        <service word="SML" tags="amenity=mortuary"/>
    </poi>
</rules>
