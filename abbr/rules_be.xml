<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- POI name abbreviations (search-word-rules v5): a name with one form gets the other form as an
         alternative name (both ways), so either form finds it -->
    <index>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАГЗС\E(?![\p{L}\p{M}\p{N}])\.?" to="Аўтагазазаправачная станцыя"/>  <!-- also: Автогазозаправочная станция -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАўтагазазаправачная станцыя\E(?![\p{L}\p{M}\p{N}])" to="АГЗС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАПС\E(?![\p{L}\p{M}\p{N}])\.?" to="Аддзяленне паштовай сувязі"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QАддзяленне паштовай сувязі\E(?![\p{L}\p{M}\p{N}])" to="АПС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QГПАП\E(?![\p{L}\p{M}\p{N}])\.?" to="Гарадскі пункт аховы правапарадку"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QГарадскі пункт аховы правапарадку\E(?![\p{L}\p{M}\p{N}])" to="ГПАП"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДАІ\E(?![\p{L}\p{M}\p{N}])\.?" to="Дзяржаўная аўтамабільная інспекцыя"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QДзяржаўная аўтамабільная інспекцыя\E(?![\p{L}\p{M}\p{N}])" to="ДАІ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЖЭС\E(?![\p{L}\p{M}\p{N}])\.?" to="Жыллёва-эксплуатацыйная служба"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЖыллёва-эксплуатацыйная служба\E(?![\p{L}\p{M}\p{N}])" to="ЖЭС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЖЭУ\E(?![\p{L}\p{M}\p{N}])\.?" to="Жыллёва-эксплуатацыйны ўчастак"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЖыллёва-эксплуатацыйны ўчастак\E(?![\p{L}\p{M}\p{N}])" to="ЖЭУ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПАВЧ\E(?![\p{L}\p{M}\p{N}])\.?" to="Пажарная аварыйна-выратавальная часць"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПажарная аварыйна-выратавальная часць\E(?![\p{L}\p{M}\p{N}])" to="ПАВЧ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПАРЧ\E(?![\p{L}\p{M}\p{N}])\.?" to="Пажарная аварыйна-ратавальная часць"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QПажарная аварыйна-ратавальная часць\E(?![\p{L}\p{M}\p{N}])" to="ПАРЧ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРАНС\E(?![\p{L}\p{M}\p{N}])\.?" to="Раённы аддзел па надзвычайных сітуацыях"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРаённы аддзел па надзвычайных сітуацыях\E(?![\p{L}\p{M}\p{N}])" to="РАНС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРАУС\E(?![\p{L}\p{M}\p{N}])\.?" to="Раённы аддзел унутраных спраў"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QРаённы аддзел унутраных спраў\E(?![\p{L}\p{M}\p{N}])" to="РАУС"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСДЮШАР\E(?![\p{L}\p{M}\p{N}])\.?" to="Спецыялізаваная дзіцяча-юнацкая школа алімпійскага рэзерву"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСпецыялізаваная дзіцяча-юнацкая школа алімпійскага рэзерву\E(?![\p{L}\p{M}\p{N}])" to="СДЮШАР"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСШ\E(?![\p{L}\p{M}\p{N}])\.?" to="Сярэдняя школа"/>  <!-- also: Средняя школа -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QСярэдняя школа\E(?![\p{L}\p{M}\p{N}])" to="СШ"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФАК\E(?![\p{L}\p{M}\p{N}])\.?" to="Фізкультурна-аздараўленчы комплекс"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФізкультурна-аздараўленчы комплекс\E(?![\p{L}\p{M}\p{N}])" to="ФАК"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФАП\E(?![\p{L}\p{M}\p{N}])\.?" to="Фельдшарска-акушэрскі пункт"/>  <!-- also: Фельдшерско-акушерский пункт -->
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QФельдшарска-акушэрскі пункт\E(?![\p{L}\p{M}\p{N}])" to="ФАП"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦРБ\E(?![\p{L}\p{M}\p{N}])\.?" to="Цэнтральная раённая бальніца"/>
        <rule object="poi" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])\QЦэнтральная раённая бальніца\E(?![\p{L}\p{M}\p{N}])" to="ЦРБ"/>
    </index>
    <!-- search-word-rules v5. service: a national service or network, the map writer gives its places a
         searchable tag (top_index); brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="Etib" tags="shop=perfumery"/>
        <brand value="Helix" tags="amenity=clinic"/>
        <brand value="Inlek" tags="amenity=pharmacy"/>
        <brand value="Megatop" tags="shop=shoes"/>
        <brand value="Ами" tags="shop=furniture"/>
        <brand value="Белнафтастрах" tags="office=insurance"/>
        <brand value="Белтэлекам" tags="office=telecommunication"/>
        <brand value="Белфармация" tags="amenity=pharmacy"/>
        <brand value="Грошык" tags="shop=convenience"/>
        <brand value="Карат" tags="shop=jewelry"/>
        <brand value="На связи" tags="shop=mobile_phone"/>
        <brand value="Элемент" tags="shop=electronics"/>
    </poi>
</rules>
