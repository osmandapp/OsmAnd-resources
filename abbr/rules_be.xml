<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <abbr short="АГЗС" full="Аўтагазазаправачная станцыя"/>  <!-- also: Автогазозаправочная станция -->
        <abbr short="АПС" full="Аддзяленне паштовай сувязі"/>
        <abbr short="ГПАП" full="Гарадскі пункт аховы правапарадку"/>
        <abbr short="ДАІ" full="Дзяржаўная аўтамабільная інспекцыя"/>
        <abbr short="ЖЭС" full="Жыллёва-эксплуатацыйная служба"/>
        <abbr short="ЖЭУ" full="Жыллёва-эксплуатацыйны ўчастак"/>
        <abbr short="ПАВЧ" full="Пажарная аварыйна-выратавальная часць"/>
        <abbr short="ПАРЧ" full="Пажарная аварыйна-ратавальная часць"/>
        <abbr short="РАНС" full="Раённы аддзел па надзвычайных сітуацыях"/>
        <abbr short="РАУС" full="Раённы аддзел унутраных спраў"/>
        <abbr short="СДЮШАР" full="Спецыялізаваная дзіцяча-юнацкая школа алімпійскага рэзерву"/>
        <abbr short="СШ" full="Сярэдняя школа"/>  <!-- also: Средняя школа -->
        <abbr short="ФАК" full="Фізкультурна-аздараўленчы комплекс"/>
        <abbr short="ФАП" full="Фельдшарска-акушэрскі пункт"/>  <!-- also: Фельдшерско-акушерский пункт -->
        <abbr short="ЦРБ" full="Цэнтральная раённая бальніца"/>
        <brand value="Etib" tags="shop=perfumery"/>
        <brand value="Helix" tags="amenity=clinic"/>
        <brand value="Inlek" tags="amenity=pharmacy"/>
        <brand value="Megatop" tags="shop=shoes"/>
        <brand value="Ами" tags="shop=furniture"/>
        <brand value="Белнафтастрах" tags="office=insurance"/>
        <brand value="Белтэлекам" tags="office=telecommunication"/>
        <brand value="Белфармация" tags="amenity=pharmacy"/>
        <brand value="Грошык" tags="shop=convenience"/>
        <brand value="Карат" tags="shop=jewelry"/>
        <brand value="На связи" tags="shop=mobile_phone"/>
        <brand value="Элемент" tags="shop=electronics"/>
    </poi>
</rules>
