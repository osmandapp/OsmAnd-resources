    <!-- Title of names: "Estrada Dr. João Abel de Freitas", "Rua Doutor Almeida". -->
    <query>
        <rule from="dr" to="Doutor"/>
        <!-- query.db: the street type users shorten ("Av. dos Aliados", "R. Lázaro da Costa"); OSM names are full. -->
        <rule from="av" to="Avenida" object="street"/>
        <rule from="r" to="Rua" object="street"/>
        <rule from="estr" to="Estrada" object="street"/>
        <rule from="de" to=""/>
        <skipPenalty>dr doutor</skipPenalty>
    </query>
