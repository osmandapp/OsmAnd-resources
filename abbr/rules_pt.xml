<?xml version="1.0" encoding="UTF-8"?>
<rules version="3">
        <query>
        <!-- Title of names: "Estrada Dr. João Abel de Freitas", "Rua Doutor Almeida"; both forms are common words. -->
        <rule from="dr" to="Doutor" common="true"/>

        <!-- query.db: the street type users shorten ("Av. dos Aliados", "R. Lázaro da Costa"); OSM names are full. -->
        <rule object="street" from="(?iu)^Av\.?$" to="Avenida"/>
        <rule object="street" from="(?iu)^R\.?$" to="Rua"/>
        <rule object="street" from="(?iu)^Estr\.?$" to="Estrada"/>

        <rule from="de" to=""/>
    </query>
</rules>
