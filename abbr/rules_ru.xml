<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- Mirror pair (rules-spec.md, 3.4) of the legacy search (master Abbreviations): a query form both ways for
         OBFs built before the index rules and alternative names both ways for new ones. -->
    <!-- "о. Кижи": an island; "остров" gets "о" as its reverse form. -->
    <rule from="о" to="Остров" object="locality,poi"/>
    <index>
        <!-- Pairs that were not in master: alternative names both ways.
             query.db: "Ленинградская ул. 53", "пер. Кронштадский", "Кемеровская обл."; OSM names keep the full word
             ("Ленинградская улица", "Кемеровская область"). -->
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])ул(?![\p{L}\p{M}\p{N}])\.?" to="Улица"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])улица(?![\p{L}\p{M}\p{N}])" to="ул"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])пер(?![\p{L}\p{M}\p{N}])\.?" to="Переулок"/>
        <rule object="street" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])переулок(?![\p{L}\p{M}\p{N}])" to="пер"/>
        <rule object="boundary" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])обл(?![\p{L}\p{M}\p{N}])\.?" to="Область"/>
        <rule object="boundary" mode="All" from="(?iu)(?&lt;![\p{L}\p{M}\p{N}])область(?![\p{L}\p{M}\p{N}])" to="обл"/>
    </index>
    <query>
        <!-- "Проспект" is also a form of "пр": an index pair to it would match one name twice ("Невский пр., 56"). -->
        <rule from="просп" to="Проспект" object="street"/>
        <!-- two meanings: "Невский пр." and "пр. Энтузиастов" (проезд) -->
        <rule from="пр">
            <to object="street">Проспект</to>
            <to object="street">Проезд</to>
        </rule>
        <!-- "д. 223", "кв. 8", "корп. 2": house and flat qualifiers, a number part, not a name synonym.
             "д." is also "деревня" in names ("подъезд к д. Ивановка"): not measured yet. -->
        <rule from="д" object="building"/>
        <rule from="кв" object="building"/>
        <rule from="корп" object="building"/>
        <rule from="и" to=""/>
    </query>
</rules>
