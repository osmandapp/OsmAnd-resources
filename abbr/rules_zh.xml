<?xml version="1.0" encoding="UTF-8"?>
<rules version="5">
    <!-- search-word-rules v5. abbr: a POI name with one form gets the other as an alternative name, both
         ways; service: a national service, the map writer gives its places a searchable tag (top_index);
         brand: indexed even below the brand-analyzer limits -->
    <poi>
        <brand value="三陽機車" tags="shop=motorcycle | shop=motorcycle_repair"/>
        <brand value="城市便捷酒店" tags="tourism=hotel"/>
        <brand value="晨光文具" tags="shop=stationery"/>
        <brand value="滙豐銀行" tags="amenity=bank"/>
        <brand value="福懋加油站" tags="amenity=fuel"/>
        <brand value="维也纳国际酒店" tags="tourism=hotel"/>
        <brand value="蔚来中心" tags="shop=car"/>
    </poi>
</rules>
